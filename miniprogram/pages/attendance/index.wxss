.name { font-size: 35rpx; font-weight: 800; margin-bottom: 10rpx; }.date { color: #12643b; background: #e9f5ee; padding: 16rpx 20rpx; border-radius: 14rpx; font-size: 24rpx; }
.rule { margin-top: 24rpx; padding: 18rpx 20rpx; border-radius: 14rpx; background: #fff6e8; color: #8a570f; font-size: 23rpx; line-height: 1.55; }.title-row .section-title { margin-top: 18rpx; }.all { color: #12643b; font-size: 25rpx; }
.summary-card { display: grid; grid-template-columns: repeat(4, 1fr); background: #fff; border-radius: 20rpx; padding: 22rpx 10rpx; margin-bottom: 10rpx; text-align: center; }.summary-card view { border-right: 1rpx solid #edf0ee; }.summary-card view:last-child { border-right: 0; }.summary-value, .summary-label { display: block; }.summary-value { font-size: 32rpx; font-weight: 800; }.summary-label { color: #7a817d; font-size: 21rpx; margin-top: 6rpx; }.present-text { color: #12643b; }.warning-text { color: #c5740d; }.danger-text { color: #c6423b; }
.student { transition: border-color .15s ease; border: 2rpx solid transparent; }.student.unmarked { border-color: #ead9bd; }.student-name { font-weight: 700; font-size: 31rpx; margin-bottom: 8rpx; }.health { color: #b45f06; font-size: 22rpx; }.status-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-top: 24rpx; }.status { text-align: center; padding: 18rpx 4rpx; border-radius: 14rpx; background: #f2f4f3; color: #707772; font-size: 24rpx; transition: transform .12s ease, background-color .12s ease; }.status:active { transform: scale(.95); }.status.active.present { background: #12643b; color: #fff; }.status.active.leave { background: #f5a623; color: #fff; }.status.active.sick { background: #667eea; color: #fff; }.status.active.absent { background: #ce4c45; color: #fff; }
.identity{display:flex;align-items:center;gap:18rpx}.student-photo{width:92rpx;height:92rpx;border-radius:50%;flex:none}.student-photo.fallback{background:#e9f5ee;color:#12643b;text-align:center;line-height:92rpx;font-weight:800}
.health-note { margin-top: 18rpx; color: #9b5c18; font-size: 23rpx; }.submit { margin: 34rpx 0 20rpx; }
.leave-locked{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx;padding:20rpx;border-radius:14rpx;background:#eef2f7;color:#526173}.leave-title{font-weight:750;color:#526173;margin-bottom:7rpx}.leave-locked>text{color:#2d5ea8;font-size:23rpx}
.trial-student{border-left:7rpx solid #d1a72f}.trial-grid{grid-template-columns:repeat(2,1fr)}.trial-rule{margin-top:16rpx}
.date{color:#173b77;background:#eaf0f9;padding:14rpx 18rpx}.all{color:#173b77}.student-photo.fallback{background:#eaf0f9;color:#173b77}
