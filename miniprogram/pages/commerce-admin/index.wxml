<view class="page page-enter"><view class="notice {{payment.configured ? 'ok' : ''}}">微信支付：{{payment.configured ? '商户参数已配置' : '尚未配置商户参数，订单可使用管理员人工确认测试'}}</view><view class="section-title">课程类型</view><view class="card"><view class="field"><text class="field-label">类型名称</text><input class="input" value="{{course.name}}" data-form="course" data-key="name" bindinput="field"/></view><view class="field"><text class="field-label">包含课时</text><input class="input" type="number" value="{{course.lessons}}" data-form="course" data-key="lessons" bindinput="field"/></view><view class="field"><text class="field-label">说明</text><input class="input" value="{{course.description}}" data-form="course" data-key="description" bindinput="field"/></view><button class="btn-primary" loading="{{saving === 'course'}}" bindtap="saveCourse">添加课程类型</button></view><view class="chips"><view class="tag" wx:for="{{config.courseTypes}}" wx:key="id">{{item.name}} · {{item.lessons}}课时</view></view><view class="section-title">教练 + 课程类型定价</view><view class="card"><view class="field"><text class="field-label">教练员</text><picker range="{{config.coaches}}" range-key="name" value="{{coachIndex}}" bindchange="coach"><view class="picker">{{config.coaches[coachIndex].name || '暂无教练'}}</view></picker></view><view class="field"><text class="field-label">课程类型</text><picker range="{{config.courseTypes}}" range-key="name" value="{{typeIndex}}" bindchange="type"><view class="picker">{{config.courseTypes[typeIndex].name || '暂无课程类型'}}</view></picker></view><view class="field"><text class="field-label">售价（元）</text><input class="input" type="digit" value="{{price.amount}}" data-form="price" data-key="amount" bindinput="field"/></view><button class="btn-primary" loading="{{saving === 'price'}}" bindtap="savePrice">保存双绑定价格</button></view><view class="card row-item" wx:for="{{config.pricingRules}}" wx:key="id"><text>{{item.coachName}} · {{item.courseTypeName}}</text><text class="price">¥{{item.amountYuan}}</text></view><view class="section-title">优惠券编码</view><view class="card"><view class="field"><text class="field-label">优惠码</text><input class="input" value="{{coupon.code}}" data-form="coupon" data-key="code" bindinput="field" placeholder="例如 NEW10"/></view><view class="field"><text class="field-label">名称</text><input class="input" value="{{coupon.name}}" data-form="coupon" data-key="name" bindinput="field"/></view><view class="field"><text class="field-label">优惠方式</text><picker range="{{discountLabels}}" value="{{discountIndex}}" bindchange="discount"><view class="picker">{{discountLabels[discountIndex]}}</view></picker></view><view class="field"><text class="field-label">{{coupon.discountType === 'PERCENT' ? '减免比例（例如10代表减10%）' : '减免金额（元）'}}</text><input class="input" type="digit" value="{{coupon.discountValue}}" data-form="coupon" data-key="discountValue" bindinput="field"/></view><view class="field"><text class="field-label">最低订单金额（元）</text><input class="input" type="digit" value="{{coupon.minAmount}}" data-form="coupon" data-key="minAmount" bindinput="field"/></view><view class="field"><text class="field-label">总使用次数（0为不限）</text><input class="input" type="number" value="{{coupon.totalLimit}}" data-form="coupon" data-key="totalLimit" bindinput="field"/></view><view class="date-row"><picker mode="date" value="{{coupon.startAt}}" data-key="startAt" bindchange="date"><view class="picker">{{coupon.startAt}}</view></picker><text>至</text><picker mode="date" value="{{coupon.endAt}}" data-key="endAt" bindchange="date"><view class="picker">{{coupon.endAt}}</view></picker></view><button class="btn-primary action" loading="{{saving === 'coupon'}}" bindtap="saveCoupon">发布优惠券</button></view><view class="card row-item" wx:for="{{config.coupons}}" wx:key="id"><view><view>{{item.code}} · {{item.name}}</view><view class="muted small">已用 {{item.usedCount || 0}} / {{item.totalLimit || '不限'}}</view></view><view class="tag">{{item.status}}</view></view></view>
