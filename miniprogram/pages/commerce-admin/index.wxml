<view class="page page-enter"><view class="notice {{payment.status === 'READY' ? 'ok' : ''}}">微信支付：{{payment.status === 'READY' ? '已就绪' : '未就绪，请检查商户配置、AppID及生产支付开关'}}</view>
<view class="section-title">课时套餐管理</view><view class="card package-form"><view class="field"><text class="field-label">套餐名称</text><input class="input" value="{{packageForm.name}}" data-key="name" bindinput="packageField" placeholder="例如14节训练套餐"/></view><view class="field"><text class="field-label">课时数量</text><input class="input" type="number" value="{{packageForm.lessonCount}}" data-key="lessonCount" bindinput="packageField"/></view><view class="field"><text class="field-label">销售价格（元）</text><input class="input" type="digit" value="{{packageForm.priceYuan}}" data-key="priceYuan" bindinput="packageField"/></view><view class="field"><text class="field-label">有效期（月）</text><input class="input" type="number" value="{{packageForm.validityMonths}}" data-key="validityMonths" bindinput="packageField"/><view class="muted small">首次正式消课后开始计算，历史订单保存购买时快照。</view></view><view class="field"><text class="field-label">套餐说明</text><input class="input" value="{{packageForm.description}}" data-key="description" bindinput="packageField" placeholder="可不填"/></view><view class="field"><text class="field-label">排序</text><input class="input" type="number" value="{{packageForm.sortOrder}}" data-key="sortOrder" bindinput="packageField"/></view><button class="btn-primary" loading="{{saving === 'package'}}" bindtap="savePackage">{{packageForm.id ? '保存套餐修改' : '新增套餐'}}</button><button class="btn-secondary" wx:if="{{packageForm.id}}" bindtap="resetPackage">取消编辑</button></view>
<view class="card package-row" wx:for="{{packages}}" wx:key="id"><view class="grow"><view class="package-name">{{item.name}}</view><view class="muted small">{{item.lessonCount}}节 · ¥{{item.priceYuan}} · 激活后{{item.validityMonths}}个月</view><view class="tag">{{item.status === 'ACTIVE' ? '销售中' : '已停售'}}</view></view><view class="package-actions"><text data-id="{{item.id}}" bindtap="editPackage">编辑</text><text data-id="{{item.id}}" data-status="{{item.status}}" bindtap="packageStatus">{{item.status === 'ACTIVE' ? '停售' : '恢复'}}</text></view></view>
<view class="section-title legacy-title">原课程定价（兼容历史订单）</view><view class="section-title">课程类型</view>
<view class="card"><view class="field"><text class="field-label">类型名称</text><input class="input" value="{{course.name}}" data-form="course" data-key="name" bindinput="field"/></view><view class="field"><text class="field-label">包含课时</text><input class="input" type="number" value="{{course.lessons}}" data-form="course" data-key="lessons" bindinput="field"/></view><view class="field"><text class="field-label">说明</text><input class="input" value="{{course.description}}" data-form="course" data-key="description" bindinput="field"/></view><button class="btn-primary" loading="{{saving === 'course'}}" bindtap="saveCourse">添加课程类型</button></view><view class="chips"><view class="tag" wx:for="{{config.courseTypes}}" wx:key="id">{{item.name}} · {{item.lessons}}课时</view></view><view class="section-title">教练 + 课程类型定价</view><view class="card"><view class="field"><text class="field-label">教练员</text><picker range="{{config.coaches}}" range-key="name" value="{{coachIndex}}" bindchange="coach"><view class="picker">{{config.coaches[coachIndex].name || '暂无教练'}}</view></picker></view><view class="field"><text class="field-label">课程类型</text><picker range="{{config.courseTypes}}" range-key="name" value="{{typeIndex}}" bindchange="type"><view class="picker">{{config.courseTypes[typeIndex].name || '暂无课程类型'}}</view></picker></view><view class="field"><text class="field-label">售价（元）</text><input class="input" type="digit" value="{{price.amount}}" data-form="price" data-key="amount" bindinput="field"/></view><button class="btn-primary" loading="{{saving === 'price'}}" bindtap="savePrice">保存双绑定价格</button></view><view class="card row-item" wx:for="{{config.pricingRules}}" wx:key="id"><text>{{item.coachName}} · {{item.courseTypeName}}</text><text class="price">¥{{item.amountYuan}}</text></view><view class="section-title">优惠券编码</view><view class="card"><view class="field"><text class="field-label">优惠码</text><input class="input" value="{{coupon.code}}" data-form="coupon" data-key="code" bindinput="field" placeholder="例如 NEW10"/></view><view class="field"><text class="field-label">名称</text><input class="input" value="{{coupon.name}}" data-form="coupon" data-key="name" bindinput="field"/></view><view class="field"><text class="field-label">优惠方式</text><picker range="{{discountLabels}}" value="{{discountIndex}}" bindchange="discount"><view class="picker">{{discountLabels[discountIndex]}}</view></picker></view><view class="field"><text class="field-label">{{coupon.discountType === 'PERCENT' ? '减免比例（例如10代表减10%）' : '减免金额（元）'}}</text><input class="input" type="digit" value="{{coupon.discountValue}}" data-form="coupon" data-key="discountValue" bindinput="field"/></view><view class="field"><text class="field-label">最低订单金额（元）</text><input class="input" type="digit" value="{{coupon.minAmount}}" data-form="coupon" data-key="minAmount" bindinput="field"/></view><view class="field"><text class="field-label">总使用次数（0为不限）</text><input class="input" type="number" value="{{coupon.totalLimit}}" data-form="coupon" data-key="totalLimit" bindinput="field"/></view><view class="date-row"><picker mode="date" value="{{coupon.startAt}}" data-key="startAt" bindchange="date"><view class="picker">{{coupon.startAt}}</view></picker><text>至</text><picker mode="date" value="{{coupon.endAt}}" data-key="endAt" bindchange="date"><view class="picker">{{coupon.endAt}}</view></picker></view><button class="btn-primary action" loading="{{saving === 'coupon'}}" bindtap="saveCoupon">发布优惠券</button></view><view class="card row-item" wx:for="{{config.coupons}}" wx:key="id"><view><view>{{item.code}} · {{item.name}}</view><view class="muted small">已用 {{item.usedCount || 0}} / {{item.totalLimit || '不限'}}</view></view><view class="tag">{{item.status}}</view></view></view>
