<view class="page page-enter"><view class="between header"><view><view class="title">俱乐部动态</view><view class="muted small">训练通知、活动和新闻</view></view><button wx:if="{{role === 'admin'}}" size="mini" class="btn-primary" bindtap="add">发布</button></view><view class="loading-state" wx:if="{{loading}}">加载中...</view><view class="card news pressable" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="edit"><image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill"/><view class="grow"><view class="between"><view class="news-title">{{item.title}}</view><view class="tag" wx:if="{{role === 'admin'}}">{{item.status === 'DRAFT' ? '草稿' : '已发布'}}</view></view><view class="muted small meta">{{item.category}} · {{item.publishedAt || item.updatedAt}}</view><view class="summary">{{item.summary}}</view><view class="content">{{item.content}}</view></view></view><view class="empty card" wx:if="{{!loading && rows.length === 0}}">暂无新闻公告</view></view>
