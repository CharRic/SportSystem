.bind-page{min-height:100vh;padding:72rpx 38rpx;background:linear-gradient(180deg,#eef3fb,#f6f8f7);box-sizing:border-box}.brand{text-align:center}.brand image{width:150rpx;height:150rpx}.title{font-size:38rpx;font-weight:800;color:#17211b;margin-top:20rpx}.desc{font-size:25rpx;color:#747d77;margin-top:12rpx}.card{margin-top:48rpx;padding:36rpx;background:#fff;border-radius:28rpx;box-shadow:0 16rpx 50rpx rgba(23,59,119,.08)}.label{font-size:25rpx;font-weight:700;margin-bottom:14rpx}.card input{height:92rpx;padding:0 24rpx;border-radius:18rpx;background:#f3f6f5;font-size:34rpx;letter-spacing:5rpx;text-align:center}.primary{margin-top:28rpx;background:#173b77;color:#fff;border-radius:46rpx;font-size:28rpx}.primary::after,.plain::after{border:0}.tip,.confirm-tip{font-size:23rpx;color:#7a817d;line-height:1.65;margin-top:24rpx}.profile{text-align:center}.profile image,.fallback{width:154rpx;height:154rpx;border-radius:50%;margin:auto;background:#e9f0fa}.fallback{line-height:154rpx;color:#173b77;font-size:50rpx;font-weight:800}.name{font-size:36rpx;font-weight:800;margin-top:20rpx}.title-line{font-size:27rpx;color:#173b77;font-weight:700;margin-top:8rpx}.certificate{font-size:24rpx;color:#846515;margin-top:14rpx}.plain{margin-top:12rpx;background:transparent;color:#66716b;font-size:25rpx}.success{text-align:center}.check{width:96rpx;height:96rpx;border-radius:50%;background:#176b42;color:#fff;line-height:96rpx;font-size:54rpx;margin:auto}.error{margin-top:24rpx;padding:20rpx;border-radius:16rpx;background:#fff0ef;color:#a5322d;text-align:center;font-size:24rpx}
