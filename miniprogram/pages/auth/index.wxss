page{background:linear-gradient(165deg,#edf5f0 0%,#f7f9f8 48%,#eef2f8 100%)}
.auth-shell{min-height:100vh;box-sizing:border-box;padding:calc(env(safe-area-inset-top) + 56rpx) 42rpx 48rpx;display:flex;flex-direction:column;justify-content:center}
.brand{text-align:center;margin-bottom:44rpx}.logo{width:150rpx;height:178rpx}.club-name{margin-top:18rpx;color:#12643b;font-size:29rpx;font-weight:700;letter-spacing:2rpx}.product-name{font-size:52rpx;font-weight:900;color:#173b77;margin-top:14rpx}.welcome{color:#747d78;font-size:26rpx;margin-top:16rpx}
.panel{background:#fff;border-radius:30rpx;padding:40rpx 34rpx;box-shadow:0 18rpx 60rpx rgba(25,67,47,.1)}
button{border:0;font-size:29rpx;font-weight:700}.primary,.secondary,.phone-button{height:92rpx;line-height:92rpx;border-radius:18rpx}.primary{background:#12643b;color:#fff}.secondary{background:#eef6f1;color:#12643b}.phone-button{background:#eaf1ff;color:#173b77;margin-bottom:18rpx}.primary::after,.secondary::after,.phone-button::after{border:0}
button{font-size:28rpx}.primary,.secondary,.phone-button{height:86rpx;line-height:86rpx;border-radius:16rpx}.primary{background:#173b77}.secondary{background:#eaf0f9;color:#173b77}
.divider{display:flex;align-items:center;gap:20rpx;color:#919993;font-size:24rpx;margin:32rpx 0}.divider text{height:2rpx;flex:1;background:#e6ebe8}.staff-link{text-align:center;color:#173b77;font-size:26rpx;padding:36rpx 0 2rpx}
.panel-title{text-align:center;color:#173b77;font-weight:800;font-size:34rpx}.panel-desc{text-align:center;color:#7c8580;font-size:24rpx;line-height:1.65;margin:14rpx 0 30rpx}.field{margin-bottom:24rpx}.field text{display:block;color:#434b47;font-size:25rpx;font-weight:700;margin-bottom:12rpx}.field input{height:88rpx;box-sizing:border-box;padding:0 24rpx;border-radius:16rpx;background:#f4f7f5}.or{text-align:center;color:#a0a7a3;font-size:22rpx;margin-bottom:18rpx}.back{text-align:center;color:#6e7872;font-size:26rpx;padding-top:30rpx}.staff-state{text-align:center;color:#616b65;font-size:27rpx;line-height:1.7;padding:32rpx 10rpx}.disabled{border-top:8rpx solid #d19a32}
.staff-auth{margin-top:28rpx;padding-top:24rpx;border-top:2rpx solid #edf0ee}.staff-auth input{height:88rpx;box-sizing:border-box;padding:0 24rpx;text-align:center;letter-spacing:12rpx;border-radius:16rpx;background:#f4f7f5;margin-bottom:18rpx}
.error{color:#b5463f;background:#fff0ee;border-radius:14rpx;padding:18rpx 22rpx;margin-top:20rpx;text-align:center;font-size:24rpx;line-height:1.55}.privacy{text-align:center;color:#929b96;font-size:21rpx;line-height:1.55;margin:30rpx 28rpx 0}
