<view class="page"><view class="card"><view class="field"><text class="field-label">标题 *</text><input class="input" value="{{item.title}}" data-key="title" bindinput="field"/></view><view class="field"><text class="field-label">分类</text><input class="input" value="{{item.category}}" data-key="category" bindinput="field"/></view><view class="field"><text class="field-label">摘要</text><textarea class="textarea short" value="{{item.summary}}" data-key="summary" bindinput="field"/></view><view class="field"><text class="field-label">正文 *</text><textarea class="textarea body" value="{{item.content}}" data-key="content" bindinput="field"/></view><view class="field"><text class="field-label">封面图片地址</text><input class="input" value="{{item.coverUrl}}" data-key="coverUrl" bindinput="field"/></view><view class="field"><text class="field-label">状态</text><picker range="{{statusLabels}}" value="{{statusIndex}}" bindchange="status"><view class="picker">{{statusLabels[statusIndex]}}</view></picker></view></view><button class="btn-primary" loading="{{saving}}" bindtap="save">保存</button></view>
