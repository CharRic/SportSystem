<view class="page"><view class="notice">同一份训练大纲供管理员维护、教练参考，并自动提取允许公开的培养目标与训练方向给家长。</view><view class="card"><view class="field"><text class="field-label">大纲名称</text><input class="input" value="{{form.name}}" data-key="name" bindinput="field"/></view><view class="field"><text class="field-label">年龄段</text><input class="input" value="{{form.ageGroup}}" placeholder="如：U7-U8" data-key="ageGroup" bindinput="field"/></view><view class="between field"><text>精英队大纲</text><switch checked="{{form.classType === 'ELITE'}}" bindchange="type" color="#173b77"/></view><view class="field"><text class="field-label">排序（数字越小越靠前）</text><input class="input" type="number" value="{{form.sortOrder}}" data-key="sortOrder" bindinput="field"/></view><view class="field"><text class="field-label">主要训练方向（家长可见）</text><checkbox-group bindchange="topics"><label class="topic" wx:for="{{topics}}" wx:key="key"><checkbox value="{{item.key}}" checked="{{item.checked}}" color="#12643b"/>{{item.name}}</label></checkbox-group></view><view class="field"><text class="field-label">阶段培养目标（家长可见）</text><textarea class="textarea" value="{{form.objectivesText}}" placeholder="使用顿号或换行分隔" data-key="objectivesText" bindinput="field"/></view><view class="field"><text class="field-label">家长公开说明</text><textarea class="textarea" value="{{form.description}}" placeholder="用简洁语言说明本阶段为什么练、希望达到什么" data-key="description" bindinput="field"/></view></view><button class="btn-primary" loading="{{saving}}" bindtap="save">保存训练大纲</button><button wx:if="{{id}}" class="btn-secondary archive" bindtap="changeStatus">{{form.active === false ? '恢复大纲' : '停用大纲'}}</button></view>
