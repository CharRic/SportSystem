.profile-head { background: linear-gradient(140deg, #0f5834, #18794a); color: #fff; text-align: center; padding: 46rpx 20rpx 66rpx; }.avatar { width: 112rpx; height: 112rpx; margin: 0 auto 18rpx; line-height: 112rpx; border-radius: 36rpx; background: rgba(255,255,255,.16); font-size: 42rpx; font-weight: 800; }.name { font-size: 36rpx; font-weight: 800; }.role { opacity: .75; margin-top: 10rpx; font-size: 24rpx; }.card-title { font-weight: 700; font-size: 31rpx; }.desc { margin: 12rpx 0 24rpx; line-height: 1.55; }.roles { display: grid; grid-template-columns: repeat(3,1fr); gap: 14rpx; }.role-btn { background: #f2f4f3; color: #707772; padding: 20rpx 6rpx; text-align: center; border-radius: 14rpx; }.role-btn.active { background: #12643b; color: #fff; }.bind { margin-top: 20rpx; }.menu-item { display: flex; justify-content: space-between; padding: 26rpx 0; border-bottom: 1rpx solid #edf0ee; }.menu-item:last-child { border-bottom: 0; }.tip { color: #8a918d; font-size: 23rpx; line-height: 1.6; padding: 30rpx 14rpx; text-align: center; }
.profile-head{background:linear-gradient(145deg,#102f63,#28569a);padding:40rpx 20rpx 56rpx}.avatar{border-radius:50%}.role-btn.active{background:#173b77}.menu-item{padding:22rpx 0;border-bottom-color:#edf1f6}.tip{padding:24rpx 14rpx;color:#7b8590}
.logout{margin-top:26rpx;background:#fff;color:#b34740;border:2rpx solid #f0d5d2;border-radius:18rpx}.logout::after{border:0}
