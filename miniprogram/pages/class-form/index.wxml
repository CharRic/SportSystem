<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view>
<view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="retry">重新加载</view></view>
<view class="page page-enter" wx:else>
  <view class="card">
    <view class="field"><text class="field-label">班级名称 *</text><input class="input" value="{{clubClass.name}}" data-key="name" bindinput="field" placeholder="例如：U10 提高班"/></view>
    <view class="field"><text class="field-label">年龄组 *</text><input class="input" value="{{clubClass.ageGroup}}" data-key="ageGroup" bindinput="field" placeholder="例如：2017/2018（U9）"/></view>
    <view class="field"><text class="field-label">标准人数 *</text><input class="input" type="number" value="{{clubClass.standardCapacity}}" data-key="standardCapacity" bindinput="field"/><view class="field-help">这是建议人数。管理员确认后可超额，家长端达到标准人数后不可报名。</view></view>
    <view class="field" wx:if="{{role === 'admin'}}"><text class="field-label">主教练 *</text><picker range="{{coaches}}" range-key="name" value="{{coachIndex}}" bindchange="coach"><view class="picker">{{coaches[coachIndex].name}}</view></picker><view class="field-help">未绑定微信的教练也可以排课；如名单中没有，请先到“教练管理”创建档案。</view></view>
    <view class="field" wx:else><text class="field-label">主教练</text><view class="input readonly">{{clubClass.headCoachName}}</view></view>
    <view class="field" wx:if="{{role === 'admin'}}"><text class="field-label">助理教练</text><checkbox-group bindchange="assistants"><label class="coach-option" wx:for="{{coaches}}" wx:key="id" wx:if="{{item.id && item.id !== clubClass.headCoachUserId}}"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#08783f"/><text>{{item.name}}</text></label></checkbox-group><view class="field-help">可多选；本班课程发布时会自动快照主教练和助理教练。</view></view>
    <view class="field" wx:else><text class="field-label">助理教练</text><view class="input readonly">{{clubClass.assistantCoachName || '未设置'}}</view></view>
    <view class="field"><text class="field-label">训练时间 *</text><view class="schedule-slot" wx:for="{{scheduleSlots}}" wx:key="index"><picker class="weekday-picker" range="{{weekdays}}" value="{{item.weekdayIndex}}" data-index="{{index}}" bindchange="slotWeekday"><view class="picker compact">{{item.weekday}}</view></picker><picker class="time-picker" mode="time" value="{{item.startTime}}" data-index="{{index}}" data-key="startTime" bindchange="slotTime"><view class="picker compact">{{item.startTime}}</view></picker><text class="time-separator">至</text><picker class="time-picker" mode="time" value="{{item.endTime}}" data-index="{{index}}" data-key="endTime" bindchange="slotTime"><view class="picker compact">{{item.endTime}}</view></picker><text class="remove-slot" wx:if="{{scheduleSlots.length > 1}}" data-index="{{index}}" bindtap="removeSlot">删除</text></view><view class="add-slot" bindtap="addSlot">＋ 添加训练时段</view></view>
    <view class="field"><text class="field-label">训练场地 *</text><input class="input" value="{{clubClass.venue}}" data-key="venue" bindinput="field" placeholder="例如：一号足球场"/></view>
    <view class="field"><text class="field-label">状态</text><picker range="{{statuses}}" range-key="label" value="{{statusIndex}}" bindchange="status"><view class="picker">{{statuses[statusIndex].label}}</view></picker></view>
    <view class="field"><text class="field-label">备注</text><textarea class="textarea" value="{{clubClass.remark}}" data-key="remark" bindinput="field" placeholder="比赛目标、训练要求等"/></view>
  </view>
  <view class="sticky-action"><button class="btn-primary" disabled="{{saving}}" loading="{{saving}}" bindtap="save">{{saving ? '正在保存' : '保存班级'}}</button></view>
</view>
