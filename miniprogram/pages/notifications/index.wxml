<view class="page page-enter"><view class="loading-state" wx:if="{{loading}}">加载中...</view><view class="card item {{item.status === 'UNREAD' ? 'unread' : ''}}" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="read"><view class="between"><view class="title">{{item.title}}</view><view class="dot" wx:if="{{item.status === 'UNREAD'}}"></view></view><view class="content">{{item.content}}</view><view class="muted small">{{item.createdAt}}</view></view><view class="empty card" wx:if="{{!loading && rows.length === 0}}">暂无通知</view></view>
