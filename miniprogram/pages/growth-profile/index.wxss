.hero{border-radius:22rpx;padding:28rpx}.eyebrow{font-size:18rpx;letter-spacing:2rpx;color:#e2bd52}.title{font-size:42rpx;font-weight:850;margin:8rpx 0}.sub{color:#dce6f6}.hero-grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:22rpx;border-top:1rpx solid rgba(255,255,255,.18);padding-top:17rpx}.hero-grid text{display:block;text-align:center}.hero-grid text:first-child{font-weight:750;font-size:23rpx}.hero-grid text:last-child{font-size:18rpx;color:#cdd9ec;margin-top:5rpx}.overall{font-size:52rpx;color:#173b77;font-weight:850}.overall text{font-size:24rpx}.chart{width:100%}.radar{height:420rpx}.trend{height:340rpx}.compare{display:grid;grid-template-columns:repeat(5,1fr);gap:6rpx}.compare view{text-align:center;background:#f5f7fa;border-radius:12rpx;padding:12rpx 3rpx}.compare text{display:block;font-size:20rpx}.compare .score{font-size:28rpx;font-weight:800;margin:5rpx 0}.delta.up{color:#17804a}.delta.down{color:#bd5b42}.limit{display:flex;gap:12rpx}.limit text{padding:9rpx 16rpx;border-radius:99rpx;background:#eef1f5;color:#728095;font-size:22rpx}.limit .active{background:#173b77;color:#fff}.headline{font-weight:750;font-size:29rpx}.copy{margin-top:14rpx;line-height:1.65;color:#526173}.copy>text{display:block;color:#173b77;font-weight:700;margin-bottom:4rpx}.tags{margin-top:12rpx}.tags text{display:inline-block;background:#eaf0f9;color:#173b77;padding:7rpx 12rpx;border-radius:99rpx;font-size:21rpx;margin:0 8rpx 8rpx 0}.record{margin-bottom:14rpx}.timeline{border-left:3rpx solid #dbe3ee;margin-left:16rpx;padding-left:26rpx}.event{position:relative}.event .dot{position:absolute;width:18rpx;height:18rpx;background:#173b77;border:6rpx solid #eaf0f9;border-radius:50%;left:-41rpx;top:26rpx}.event .card{margin-bottom:14rpx}
.player-photo{width:112rpx;height:112rpx;border-radius:50%;border:4rpx solid rgba(255,255,255,.8);float:right}
