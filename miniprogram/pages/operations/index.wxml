<view class="page page-enter">
  <view class="admin-head brand-hero"><view class="eyebrow">NANLIAN OPERATIONS</view><view class="title">运营驾驶舱</view><view class="sub">数据留痕 · 权限分开 · 异常闭环</view></view>
  <view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重试</view></view>
  <block wx:else>
    <view class="metrics"><view><text>{{data.metrics.students}}</text><text>学员</text></view><view><text>{{data.metrics.sessions}}</text><text>近期课程</text></view><view><text>{{data.metrics.classMembers}}</text><text>班级成员</text></view><view><text>{{data.metrics.attendanceRate}}%</text><text>到课率</text></view><view><text>{{data.metrics.pendingLeaves}}</text><text>待审请假</text></view><view><text>¥{{data.metrics.revenueYuan}}</text><text>实收收入</text></view></view>
    <view class="section-title">快捷管理</view><view class="quick"><view bindtap="crm">招生中心</view><view bindtap="training">训练管理</view><view bindtap="growth">成长管理 / 阶段测评</view><view bindtap="elite">精英队选拔</view><view bindtap="league">周日成长联赛</view><view bindtap="addSession">＋ 发布课程</view><view bindtap="schedule">南联总课表</view><view bindtap="workload">教练课时统计</view><view bindtap="classes">▦ 班级管理</view><view bindtap="accounts">账号与管理员</view><view bindtap="leaves">✓ 请假审批</view><view bindtap="commerce">课程定价与优惠券</view><view bindtap="orders">¥ 订单管理</view><view wx:if="{{data.role === 'admin'}}" bindtap="paymentDiagnostics">微信支付状态</view><view bindtap="news">新闻广告</view></view>
    <view class="section-title">运营预警</view><view class="card alert {{item.level}}" wx:for="{{data.alerts}}" wx:key="text"><text>!</text><view>{{item.text}}</view></view>
    <view class="section-title">近期课程</view><view class="card session" wx:for="{{data.sessions}}" wx:key="id"><view class="grow"><view class="name">{{item.title}}</view><view class="muted small">{{item.date}} {{item.time}} · {{item.venue}}</view><view class="small mt">正式成员 {{item.memberCount}} / 标准人数 {{item.standardCapacity}}</view></view><button size="mini" data-id="{{item.id}}" bindtap="attendance">点名</button></view>
    <view class="section-title">最近操作记录</view><view class="card log" wx:for="{{data.auditLogs}}" wx:key="id"><view><view>{{item.action}} · {{item.targetType}}</view><view class="muted small">{{item.detail}}</view></view><text class="muted small">{{item.createdAt}}</text></view><view class="empty card" wx:if="{{data.auditLogs.length === 0}}">暂无操作记录</view>
  </block>
</view>
