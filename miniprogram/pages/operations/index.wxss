.admin-head{border-radius:28rpx;padding:34rpx}.eyebrow{font-size:19rpx;letter-spacing:2rpx;color:#e2bd52}.title{font-size:43rpx;font-weight:800;margin:10rpx 0}.sub{color:#dce6f6}.metrics{display:grid;grid-template-columns:repeat(3,1fr);background:#fff;border-radius:22rpx;margin-top:20rpx;box-shadow:0 8rpx 24rpx rgba(20,45,85,.06)}.metrics view{text-align:center;padding:22rpx 6rpx;border-right:1rpx solid #edf0f5;border-bottom:1rpx solid #edf0f5}.metrics text{display:block}.metrics text:first-child{font-size:36rpx;font-weight:800;color:#173b77}.metrics text:last-child{font-size:20rpx;color:#8791a3;margin-top:4rpx}.quick{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.quick view{background:#fff;border-radius:18rpx;padding:24rpx;color:#173b77;font-weight:700;box-shadow:0 7rpx 20rpx rgba(20,45,85,.05)}.alert{display:flex;gap:16rpx;align-items:center}.alert>text{width:42rpx;height:42rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#fff1d8;color:#9a6b00;font-weight:800}.alert.danger>text{background:#ffe8e8;color:#b53737}.session{display:flex;align-items:center}.session .name{font-size:30rpx;font-weight:700}.session button{background:#173b77;color:#fff;border-radius:99rpx}.mt{margin-top:8rpx}.log{display:flex;justify-content:space-between;gap:16rpx}
.admin-head{border-radius:22rpx;padding:30rpx}.metrics{border:1rpx solid #edf1f6;border-radius:18rpx;margin-top:16rpx;box-shadow:0 4rpx 16rpx rgba(20,45,85,.04)}.quick view{border:1rpx solid #edf1f6;padding:21rpx;box-shadow:0 4rpx 14rpx rgba(20,45,85,.04)}
