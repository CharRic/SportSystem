.week-nav{display:flex;justify-content:space-between;background:#fff;border-radius:20rpx;padding:22rpx;margin:20rpx 0;color:#173b77}.week-nav .current{background:#173b77;color:#fff;border-radius:999rpx;padding:10rpx 28rpx}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx}.stats view{background:#fff;border-radius:18rpx;padding:18rpx 4rpx;text-align:center}.stats text{display:block}.stats text:first-child{font-size:34rpx;font-weight:800;color:#173b77}.stats text:last-child{font-size:20rpx;color:#7a817d}.tools{display:flex;justify-content:space-between;color:#08783f;padding:24rpx 6rpx}.day-title{font-size:30rpx;font-weight:800;margin:26rpx 0 14rpx}.timeline{border-left:4rpx solid #d9e9df;padding-left:22rpx}.card{background:#fff;border-radius:22rpx;padding:24rpx;margin-bottom:16rpx}.time{color:#08783f;font-size:28rpx;font-weight:800}.between{display:flex;justify-content:space-between}.name{font-size:31rpx;font-weight:800;margin-top:10rpx}.tag{background:#edf1f8;color:#173b77;padding:7rpx 14rpx;border-radius:999rpx;font-size:21rpx}.tag.substitute{background:#fff0d9;color:#a86100}.meta,.theme,.original,.status{font-size:23rpx;color:#66716b;margin-top:9rpx}.original{color:#a86100}
.tools{color:#173b77;padding:20rpx 6rpx}.timeline{border-left-color:#dbe3ee;padding-left:20rpx}.card{border:1rpx solid #edf1f6;border-radius:20rpx;padding:22rpx;margin-bottom:14rpx}.time{color:#173b77}
