.form-section{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;box-shadow:0 10rpx 34rpx rgba(27,69,47,.06)}.public-section{border-top:8rpx solid #173b77}.internal-section{border-top:8rpx solid #d1a72f}.form-title{font-size:34rpx;font-weight:800}.form-tip{font-size:23rpx;color:#7a817d;margin:8rpx 0 28rpx}.photo-title{text-align:center;font-size:25rpx;font-weight:700;color:#37423c}.avatar-editor{display:flex;flex-direction:column;align-items:center;padding:16rpx 0 30rpx;color:#173b77;font-size:23rpx}.avatar-editor image,.avatar-empty{width:168rpx;height:168rpx;border-radius:50%;margin-bottom:12rpx;box-shadow:0 10rpx 28rpx rgba(23,59,119,.12)}.avatar-empty{background:#eaf0f9;text-align:center;line-height:168rpx;font-weight:700}.photo-name{font-size:30rpx;font-weight:800;color:#17211b}.photo-empty-tip{color:#9a6a16;margin-top:6rpx}.photo-change,.photo-cancel,.photo-save{margin-top:16rpx;padding:0 28rpx;line-height:66rpx;border-radius:34rpx;font-size:24rpx}.photo-change{background:#eaf0f9;color:#173b77}.photo-cancel{background:#eef1ef;color:#68706b}.photo-save{background:#173b77;color:#fff}.photo-change::after,.photo-cancel::after,.photo-save::after{border:0}.photo-actions{display:flex;gap:16rpx}.photo-actions button{margin-left:0;margin-right:0}.photo-hint{margin-top:12rpx;color:#7a817d;text-align:center}.textarea.compact{min-height:112rpx}.counter{font-size:22rpx;color:#7a817d;font-weight:400}.counter.over{color:#bd352f}.switch-row{padding-top:8rpx}
.binding-section{border-top:8rpx solid #176b42}.account-badge{padding:8rpx 16rpx;border-radius:18rpx;font-size:22rpx;font-weight:800;white-space:nowrap}.account-badge.BOUND{background:#e4f4eb;color:#176b42}.account-badge.UNBOUND{background:#fff2cf;color:#8b6500}.account-badge.INACTIVE{background:#ecefee;color:#6f7772}.binding-body{padding:20rpx 0 4rpx;font-size:27rpx}.binding-meta{font-size:23rpx;color:#7a817d;margin-top:10rpx;line-height:1.5}.invite-box{text-align:center;padding:20rpx;border-radius:20rpx;background:#f5f8f7}.invite-box image{width:320rpx;height:320rpx;background:#fff;border-radius:16rpx}.invite-code{font-size:42rpx;font-weight:900;letter-spacing:6rpx;color:#173b77;margin-top:14rpx}.invite-actions{display:flex;gap:14rpx;margin-top:18rpx}.invite-actions button{flex:1;margin:0}.binding-primary,.minor,.danger-outline{font-size:24rpx;border-radius:34rpx;line-height:68rpx}.binding-primary{margin-top:16rpx;background:#176b42;color:#fff}.minor{background:#eaf0f9;color:#173b77}.danger-outline{margin-top:18rpx;background:#fff1f0;color:#a5322d}.binding-primary::after,.minor::after,.danger-outline::after{border:0}.status-control{border-top:1rpx solid #edf0ee;margin-top:24rpx;padding-top:18rpx}
