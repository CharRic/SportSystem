<view class="page page-enter" wx:if="{{!loading && session}}"><view class="card"><view class="card-title">取消已发布课程</view><view class="muted">{{session.title}} · {{session.date}} {{session.time}}</view><view class="warning">取消不会扣课时。补偿只针对取消当时该班的正式成员，同一课程只执行一次。</view></view><view class="card"><view class="field"><text class="field-label">取消原因</text><picker range="{{reasons}}" range-key="label" value="{{reasonIndex}}" bindchange="reasonChange"><view class="picker">{{reasons[reasonIndex].label}}</view></picker></view><view class="field"><text class="field-label">补充说明</text><textarea class="textarea" value="{{reason}}" bindinput="reasonInput" placeholder="可填写具体天气、场地或俱乐部安排"/></view><view class="field"><text class="field-label">补偿方式</text><picker range="{{compensations}}" range-key="label" value="{{compensationIndex}}" bindchange="compensationChange"><view class="picker">{{compensations[compensationIndex].label}}</view></picker></view><view class="field" wx:if="{{compensations[compensationIndex].value === 'EXTEND_VALIDITY'}}"><text class="field-label">顺延天数</text><input class="input" type="number" value="{{extensionDays}}" bindinput="daysInput"/><view class="muted small">未激活权益将先记录延期天数，在首次正式消课激活时一并计算。</view></view><view class="field" wx:if="{{compensations[compensationIndex].value === 'MAKEUP_SESSION'}}"><text class="field-label">对应补课课程</text><picker range="{{replacements}}" range-key="displayName" value="{{replacementIndex}}" bindchange="replacementChange"><view class="picker">{{replacements.length ? replacements[replacementIndex].displayName : '请先为同班级创建补课课程'}}</view></picker><view class="muted small">选择补课后不再同时执行有效期顺延。</view></view></view><button class="btn-primary danger-button" loading="{{saving}}" bindtap="submit">确认取消并执行补偿</button></view><view class="loading-state" wx:else>加载中...</view>
