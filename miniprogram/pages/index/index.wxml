<view class="hero">
  <view class="hero-top"><image class="club-logo" src="/images/nanlian-logo.png" mode="aspectFit"/><view class="grow"><view class="eyebrow">NANLIAN FOOTBALL CLUB</view><view class="hello">你好，{{user.name || '南联家人'}}</view><view class="hero-sub">{{roleLabel}} · 训练有标准，成长有记录</view></view></view>
</view>
<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view><view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重新加载</view></view>
<view class="page page-enter content" wx:else>
  <picker wx:if="{{dashboard.role === 'parent' && familyStudents.length > 1}}" range="{{familyStudents}}" range-key="name" value="{{activeStudentIndex}}" bindchange="activeStudentChange"><view class="card child-switch"><image wx:if="{{familyStudents[activeStudentIndex].avatarUrl}}" src="{{familyStudents[activeStudentIndex].avatarUrl}}" mode="aspectFill"/><view wx:else class="switch-fallback">{{familyStudents[activeStudentIndex].initial}}</view><view class="grow"><view class="muted small">当前孩子</view><view>{{familyStudents[activeStudentIndex].name}}</view></view><text class="link">切换 ▾</text></view></picker>
  <view class="card parent-empty" wx:if="{{parentEmpty}}">
    <view class="empty-ball">⚽</view><view class="empty-title">欢迎加入南联</view>
    <view class="empty-copy">您还没有添加孩子信息</view>
    <view class="empty-benefits"><view>添加孩子后，可以查看：</view><view>课程 · 课表 · 请假 · 成长档案 · 比赛安排</view></view>
    <button class="btn-primary add-child" bindtap="goAddChild">＋ 添加孩子</button>
  </view>
  <block wx:else>
  <view class="stats"><view class="stat pressable" bindtap="goStudents"><text class="stat-value">{{dashboard.studentCount}}</text><text class="stat-label">学员</text></view><view class="stat pressable" bindtap="goSessions"><text class="stat-value">{{dashboard.sessions.length}}</text><text class="stat-label">近期课程</text></view><view class="stat pressable" bindtap="goStudents"><text class="stat-value warn">{{dashboard.lowBalance}}</text><text class="stat-label">课时不足</text></view><view class="stat pressable" bindtap="goLeaves"><text class="stat-value">{{dashboard.pendingLeaves}}</text><text class="stat-label">待审请假</text></view></view>
  <view class="section-title">快捷入口</view><view class="quick-grid"><view class="quick pressable" bindtap="goTimetable"><view class="quick-icon blue">表</view><text>{{dashboard.role === 'admin' ? '总课表' : '我的课表'}}</text></view><view class="quick pressable" wx:if="{{dashboard.role !== 'parent'}}" bindtap="goCrm"><view class="quick-icon green">招</view><text>{{dashboard.role === 'admin' ? '招生中心' : '我的招生'}}</text></view><view class="quick pressable" wx:if="{{dashboard.role === 'admin'}}" bindtap="goTraining"><view class="quick-icon green">训</view><text>训练管理</text></view><view class="quick pressable" wx:if="{{dashboard.role === 'coach'}}" bindtap="goCurriculums"><view class="quick-icon green">纲</view><text>训练大纲</text></view><view class="quick pressable" wx:if="{{dashboard.role === 'coach'}}" bindtap="goWeeklyPlans"><view class="quick-icon gold">周</view><text>周训练计划</text></view><view class="quick pressable" bindtap="goGrowth"><view class="quick-icon green">长</view><text>{{dashboard.role === 'parent' ? '成长档案' : dashboard.role === 'coach' ? '阶段测评' : '成长管理'}}</text></view><view class="quick pressable" wx:if="{{dashboard.role !== 'parent'}}" bindtap="goElite"><view class="quick-icon gold">精</view><text>{{dashboard.role === 'admin' ? '精英队选拔' : '精英队推荐'}}</text></view><view class="quick pressable" bindtap="goLeague"><view class="quick-icon blue">赛</view><text>周日成长联赛</text></view><view class="quick pressable" bindtap="goClasses"><view class="quick-icon blue">班</view><text>班级报名</text></view><view class="quick pressable" bindtap="goStudents"><view class="quick-icon gold">人</view><text>{{dashboard.role === 'parent' ? '我的学员' : '学员档案'}}</text></view><view class="quick pressable" bindtap="goCoachTeam"><view class="quick-icon green">教</view><text>教练员简历</text></view><view class="quick pressable" bindtap="goNews"><view class="quick-icon navy">讯</view><text>新闻公告</text></view><view class="quick pressable" wx:if="{{dashboard.role !== 'coach'}}" bindtap="goRenewals"><view class="quick-icon orange">¥</view><text>课程购买</text></view><view class="quick pressable" wx:else bindtap="goCoachWorkbench"><view class="quick-icon orange">✓</view><text>教练工作台</text></view><view class="quick pressable" wx:if="{{dashboard.role !== 'parent'}}" bindtap="goOperations"><view class="quick-icon navy">管</view><text>运营后台</text></view></view>
  <view class="section-title" wx:if="{{dashboard.role === 'admin'}}">今日课程</view><view class="notice card pressable" wx:if="{{dashboard.role === 'admin'}}" bindtap="goTimetable"><view class="notice-title">今日 {{todayScheduleStats.total}} 节</view><view>进行中 {{todayScheduleStats.inProgress}} · 待开始 {{todayScheduleStats.upcoming}}</view><view class="muted small">进入南联课程总表 ›</view></view>
  <view class="section-title" wx:if="{{nextSchedule}}">{{dashboard.role === 'admin' ? '下一课程' : dashboard.role === 'coach' ? '下一节课' : '下一安排'}}</view><view class="notice card pressable" wx:if="{{nextSchedule}}" bindtap="openNext"><view class="notice-title">{{nextSchedule.studentName ? nextSchedule.studentName + ' · ' : ''}}{{nextSchedule.className}}</view><view>{{nextSchedule.date}} {{nextSchedule.time}} · {{nextSchedule.venue}}</view><view class="muted small">{{nextSchedule.sourceLabel}} · {{nextSchedule.primaryCoach.name || '教练待定'}} · 查看课表 ›</view></view>
  <view class="notice card pressable" bindtap="goNews"><view class="notice-title">俱乐部公告</view><view>查看最新训练安排、活动和课程通知。</view></view>
  <view class="between section-row"><view class="section-title">近期课程</view><text class="link" bindtap="goSessions">全部 ›</text></view><view class="card class-card" wx:for="{{dashboard.sessions}}" wx:key="id"><view class="grow"><view class="class-name">{{item.title}}</view><view class="muted small class-meta">{{item.date}} {{item.time}} · {{item.venue}}</view><view class="small">{{item.focus}} · 正式成员 {{item.memberCount}} / 标准人数 {{item.standardCapacity}}</view></view><button wx:if="{{dashboard.role !== 'parent'}}" class="mini-btn" data-id="{{item.id}}" bindtap="takeAttendance">点名</button><view wx:else class="tag">{{item.myStatus === 'booked' ? '正式成员' : item.myStatus === 'leave_pending' ? '请假待审批' : item.myStatus === 'leave_approved' ? '已请假' : item.myStatus === 'leave_rejected' ? '请假被拒绝' : item.classType === 'ELITE' ? '选拔制' : item.isFull ? '本班已满' : '可报名'}}</view></view><view class="empty card" wx:if="{{dashboard.sessions.length === 0}}">暂无已发布课程</view>
  <view class="section-title">{{dashboard.role === 'parent' ? '孩子课时' : '低课时提醒'}}</view><view class="card pressable student-row" wx:for="{{dashboard.recentStudents}}" wx:key="id" data-id="{{item.id}}" bindtap="goStudent"><image wx:if="{{item.avatarUrl}}" class="avatar student-photo" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar">{{item.initial}}</view><view class="grow"><view class="student-name">{{item.name}}</view><view class="muted small">{{item.classNames || item.guardianName}}</view></view><view class="balance {{item.lowBalance ? 'low' : ''}}"><text>{{item.remainingLessons}}</text><text class="small">节</text></view></view>
  </block>
</view>
