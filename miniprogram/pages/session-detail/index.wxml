<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view>
<view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重试</view></view>
<view class="page page-enter detail" wx:elif="{{session}}">
  <view class="hero brand-hero"><view class="tag gold">{{session.enrollmentMode === 'fixed' ? '梯队固定课' : '开放报名'}}</view><view class="title">{{session.title}}</view><view class="focus">{{session.focus}}</view></view>
  <view class="card cancellation" wx:if="{{session.status === 'CANCELLED'}}"><view class="card-title">本课程已取消</view><view>{{session.cancelReasonLabel || '课程安排调整'}}</view><view class="muted small" wx:if="{{session.compensationType === 'EXTEND_VALIDITY'}}">本次未扣课，受影响正式成员的当前课时权益有效期顺延{{session.compensationExtensionDays}}天。</view><view class="muted small" wx:elif="{{session.compensationType === 'MAKEUP_SESSION'}}">本次未扣课，俱乐部已安排对应补课。</view><view class="makeup" wx:if="{{session.makeupSession}}"><view class="card-title">补课安排</view><view>{{session.makeupSession.date}} {{session.makeupSession.time}}</view><view>{{session.makeupSession.venue}} · {{session.makeupSession.coachName}}</view></view></view>
  <view class="card info"><view><text>日期</text><text>{{session.date}} {{session.weekday}}</text></view><view><text>时间</text><text>{{session.time}}</text></view><view><text>场地</text><text>{{session.venue}}</text></view><view><text>教练</text><view class="detail-coach"><image wx:if="{{session.coach.avatarUrl}}" src="{{session.coach.avatarUrl}}" mode="aspectFill"/><view wx:else class="coach-avatar-fallback">教</view><text>{{session.coach.name || session.coachName}}</text></view></view></view>
  <view class="card class-link pressable" wx:if="{{role === 'parent'}}" bindtap="classDetail"><view><view class="muted small">所属班级</view><view class="card-title">{{session.className || session.title}}</view></view><text class="link">查看班级 ›</text></view>
  <view class="card" wx:if="{{session.trainingTheme || session.trainingFocus}}"><view class="card-title">本节训练</view><view class="training-theme" wx:if="{{session.trainingTheme}}">{{session.trainingTheme}}</view><view class="muted" wx:if="{{session.trainingFocus}}">训练重点：{{session.trainingFocus}}</view><view class="muted small" wx:if="{{role !== 'parent' && session.trainingNote}}">内部备注：{{session.trainingNote}}</view></view>
  <view class="card stage-link pressable" wx:if="{{role === 'parent'}}" bindtap="classDetail"><view><view class="muted small">所属训练阶段</view><view class="card-title">{{session.ageGroup || '阶段培养内容'}}</view><view class="muted small">查看阶段培养目标与主要训练方向</view></view><text class="link">查看 ›</text></view>
  <view class="card" wx:if="{{role !== 'parent'}}"><view class="card-title">本节教练安排</view><view class="muted small">计划教练</view><view class="coach-line" wx:for="{{session.plannedCoaches}}" wx:key="coachId"><text>{{item.coach.name}}</text><text>{{item.roleLabel}}</text></view><view wx:if="{{session.actualCoaches.length}}"><view class="muted small coach-label">实际执教</view><view class="coach-line" wx:for="{{session.actualCoaches}}" wx:key="coachId"><text>{{item.coach.name}}</text><text>{{item.roleLabel}}</text></view></view><view class="muted small" wx:if="{{session.substitutionReason}}">调整原因：{{session.substitutionReason}}</view></view>
  <view class="card"><view class="between"><view><view class="muted small">正式成员 + 体验课 / 本节容量</view><view class="capacity">{{session.memberCount}} + {{session.trialCount || 0}} / {{session.capacity || session.standardCapacity}}</view></view><view class="tag {{session.overCapacity ? 'gold' : ''}}">{{session.overCapacity ? '超出标准'+session.overCapacity+'人' : session.isFull ? '本节已满' : '可安排体验'}}</view></view><view class="progress"><view style="width:{{progress}}%"></view></view><view class="muted small rule">正式成员名单固定；体验课不创建班级成员、不扣课时；请假只影响本节出勤。</view></view>
  <view class="card attendance-stats"><view><text>{{session.memberCount}}</text><text>班级成员</text></view><view><text>{{session.attendanceStats.expected}}</text><text>本节应到</text></view><view><text>{{session.attendanceStats.present}}</text><text>到课</text></view><view><text>{{session.attendanceStats.leave}}</text><text>请假</text></view><view><text>{{session.attendanceStats.absent}}</text><text>缺勤</text></view></view>
  <block wx:if="{{role !== 'parent'}}">
    <view class="section-title">学员自助签到</view><view class="card"><view wx:if="{{checkinInfo.open}}"><view class="between"><view><view class="muted small">当前签到校验码</view><view class="checkin-code">{{checkinInfo.code}}</view></view><view class="tag">{{checkinInfo.radius}}米内</view></view><button class="btn-secondary" bindtap="closeCheckin">关闭签到</button></view><button wx:else class="btn-primary" loading="{{openingCheckin}}" bindtap="openCheckin">以当前位置发布签到</button><view class="muted small checkin-help">签到默认有效30分钟、范围300米；教练仍可使用名单点名。</view></view>
    <view class="section-title">课程管理</view><view class="actions"><button class="btn-primary" bindtap="attendance">手机点名</button><button class="btn-secondary" bindtap="trainingEdit">编辑训练重点</button><button class="btn-secondary" bindtap="evaluation">训练评价</button><button class="btn-secondary" bindtap="leaves">请假审核</button><button wx:if="{{session.status !== 'COMPLETED' && session.status !== 'CANCELLED'}}" class="btn-secondary" bindtap="complete">完成课程</button><button wx:if="{{role === 'admin'}}" class="btn-secondary" bindtap="coachEdit">更换本节教练</button><button wx:if="{{role === 'admin'}}" class="btn-secondary" bindtap="edit">编辑课程</button><button wx:if="{{role === 'admin' && session.status !== 'CANCELLED'}}" class="btn-secondary" bindtap="cancelSession">取消课程</button></view>
    <view class="section-title">正式学员应到名单</view><view class="card roster" wx:for="{{session.enrollments}}" wx:key="id"><image wx:if="{{item.student.avatarUrl}}" class="avatar photo" src="{{item.student.avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar">{{item.student.initial}}</view><view class="grow"><view class="student-name">{{item.student.name}}</view><view class="muted small">剩余 {{item.student.remainingLessons}} 节</view></view><view class="tag" wx:if="{{item.attendanceStatus !== 'unmarked'}}">{{item.attendanceStatus === 'present' ? '到课' : item.attendanceStatus === 'leave' ? '已请假' : item.attendanceStatus === 'sick' ? '伤病' : '缺勤'}}</view></view><view class="empty card" wx:if="{{!session.enrollments || session.enrollments.length === 0}}">暂无正式学员</view>
    <view class="section-title" wx:if="{{session.trialStudents.length}}">体验学员</view><view class="card roster" wx:for="{{session.trialStudents}}" wx:key="trialId"><view class="avatar">{{item.initial}}</view><view class="grow"><view class="student-name">{{item.name}}</view><view class="muted small">体验课 · 不扣课时</view></view><view class="tag">{{item.attendanceStatus === 'present' ? '到课' : item.attendanceStatus === 'absent' ? '未到' : '待点名'}}</view></view>
  </block>
  <view class="card" wx:if="{{role === 'parent' && session.checkinOpen && session.myStatus === 'booked'}}"><view class="card-title">课程签到</view><view class="muted small checkin-help">输入教练发布的6位校验码，并允许获取当前位置。</view><input class="input code-input" type="number" maxlength="6" value="{{checkinCode}}" bindinput="code" placeholder="6位校验码"/><button class="btn-primary" loading="{{checkingIn}}" bindtap="selfCheckin">定位并签到</button></view>
  <view class="bottom-space" wx:if="{{role === 'parent' && session.status !== 'CANCELLED'}}"></view><view class="fixed" wx:if="{{role === 'parent' && session.status !== 'CANCELLED'}}"><button class="{{session.myStatus === 'booked' || session.myStatus === 'leave_pending' ? 'btn-secondary' : 'btn-primary'}}" disabled="{{session.myStatus === 'leave_approved' || session.classType === 'ELITE' && session.myStatus === 'none' || (session.isFull && session.myStatus === 'none')}}" loading="{{acting}}" bindtap="primary">{{session.myStatus === 'booked' ? '申请请假' : session.myStatus === 'leave_pending' ? '待审批 · 可撤销请假' : session.myStatus === 'leave_approved' ? '已请假 · 本次不扣课时' : session.myStatus === 'leave_rejected' ? '请假被拒绝 · 重新申请' : session.classType === 'ELITE' ? '精英队由俱乐部选拔' : session.isFull ? '本班已满' : '报名本班'}}</button></view>
</view>
