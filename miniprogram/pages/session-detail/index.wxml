<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view>
<view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重试</view></view>
<view class="page page-enter detail" wx:elif="{{session}}">
  <view class="hero brand-hero"><view class="tag gold">{{session.enrollmentMode === 'fixed' ? '梯队固定课' : '开放报名'}}</view><view class="title">{{session.title}}</view><view class="focus">{{session.focus}}</view></view>
  <view class="card info"><view><text>日期</text><text>{{session.date}} {{session.weekday}}</text></view><view><text>时间</text><text>{{session.time}}</text></view><view><text>场地</text><text>{{session.venue}}</text></view><view><text>教练</text><text>{{session.coachName}}</text></view></view>
  <view class="card"><view class="between"><view><view class="muted small">班级正式成员 / 标准人数</view><view class="capacity">{{session.memberCount}} / {{session.standardCapacity}}</view></view><view class="tag {{session.overCapacity ? 'gold' : ''}}">{{session.overCapacity ? '超出标准'+session.overCapacity+'人' : session.isFull ? '本班已满' : '可报名'}}</view></view><view class="progress"><view style="width:{{progress}}%"></view></view><view class="muted small rule">正式成员名单固定；请假只影响本节出勤，批准请假不扣课时。</view></view>
  <view class="card attendance-stats"><view><text>{{session.memberCount}}</text><text>班级成员</text></view><view><text>{{session.attendanceStats.expected}}</text><text>本节应到</text></view><view><text>{{session.attendanceStats.present}}</text><text>到课</text></view><view><text>{{session.attendanceStats.leave}}</text><text>请假</text></view><view><text>{{session.attendanceStats.absent}}</text><text>缺勤</text></view></view>
  <block wx:if="{{role !== 'parent'}}">
    <view class="section-title">学员自助签到</view><view class="card"><view wx:if="{{checkinInfo.open}}"><view class="between"><view><view class="muted small">当前签到校验码</view><view class="checkin-code">{{checkinInfo.code}}</view></view><view class="tag">{{checkinInfo.radius}}米内</view></view><button class="btn-secondary" bindtap="closeCheckin">关闭签到</button></view><button wx:else class="btn-primary" loading="{{openingCheckin}}" bindtap="openCheckin">以当前位置发布签到</button><view class="muted small checkin-help">签到默认有效30分钟、范围300米；教练仍可使用名单点名。</view></view>
    <view class="section-title">课程管理</view><view class="actions"><button class="btn-primary" bindtap="attendance">手机点名</button><button class="btn-secondary" bindtap="leaves">请假审核</button><button wx:if="{{role === 'admin'}}" class="btn-secondary" bindtap="edit">编辑课程</button></view>
    <view class="section-title">应到名单</view><view class="card roster" wx:for="{{session.enrollments}}" wx:key="id"><image wx:if="{{item.student.avatarUrl}}" class="avatar photo" src="{{item.student.avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar">{{item.student.initial}}</view><view class="grow"><view class="student-name">{{item.student.name}}</view><view class="muted small">剩余 {{item.student.remainingLessons}} 节</view></view><view class="tag" wx:if="{{item.attendanceStatus !== 'unmarked'}}">{{item.attendanceStatus === 'present' ? '到课' : item.attendanceStatus === 'leave' ? '已请假' : item.attendanceStatus === 'sick' ? '伤病' : '缺勤'}}</view></view><view class="empty card" wx:if="{{!session.enrollments || session.enrollments.length === 0}}">暂无应到学员</view>
  </block>
  <view class="card" wx:if="{{role === 'parent' && session.checkinOpen && session.myStatus === 'booked'}}"><view class="card-title">课程签到</view><view class="muted small checkin-help">输入教练发布的6位校验码，并允许获取当前位置。</view><input class="input code-input" type="number" maxlength="6" value="{{checkinCode}}" bindinput="code" placeholder="6位校验码"/><button class="btn-primary" loading="{{checkingIn}}" bindtap="selfCheckin">定位并签到</button></view>
  <view class="bottom-space" wx:if="{{role === 'parent'}}"></view><view class="fixed" wx:if="{{role === 'parent'}}"><button class="{{session.myStatus === 'booked' || session.myStatus === 'leave_pending' ? 'btn-secondary' : 'btn-primary'}}" disabled="{{session.myStatus === 'leave_approved' || session.classType === 'ELITE' && session.myStatus === 'none' || (session.isFull && session.myStatus === 'none')}}" loading="{{acting}}" bindtap="primary">{{session.myStatus === 'booked' ? '申请请假' : session.myStatus === 'leave_pending' ? '待审批 · 可撤销请假' : session.myStatus === 'leave_approved' ? '已请假 · 本次不扣课时' : session.myStatus === 'leave_rejected' ? '请假被拒绝 · 重新申请' : session.classType === 'ELITE' ? '精英队由俱乐部选拔' : session.isFull ? '本班已满' : '报名本班'}}</button></view>
</view>
