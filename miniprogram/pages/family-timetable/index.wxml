<view class="page"><view class="brand-hero"><view class="eyebrow">FAMILY TIMETABLE</view><view class="title">我的课表</view><view class="sub">训练、请假与比赛日程集中查看</view></view><picker range="{{choices}}" range-key="name" value="{{choiceIndex}}" bindchange="student"><view class="child-picker">当前查看：{{choices[choiceIndex].name || '我的孩子'}} 〉</view></picker><view class="week-nav"><text bindtap="previous">‹ 上一周</text><text class="current" bindtap="current">本周</text><text bindtap="next">下一周 ›</text></view><view class="summary"><text>本周 {{timetable.stats.total || 0}} 节训练</text><text>{{timetable.stats.matches || 0}} 场比赛</text></view><view class="loading-state" wx:if="{{loading}}">加载中</view><view class="empty card" wx:elif="{{error}}">{{error}}<view class="link" bindtap="load">重新加载</view></view><block wx:else><view class="day" wx:for="{{groups}}" wx:key="date"><view class="day-title">{{item.date}}</view><view class="timeline"><view class="card schedule" wx:for="{{item.items}}" wx:for-item="course" wx:key="id" data-id="{{course.sessionId}}" data-student="{{course.studentId}}" data-type="{{course.sourceType}}" bindtap="open"><view class="between"><view><text class="tag">{{course.sourceLabel}}</text><text class="child" wx:if="{{studentId === 'ALL'}}">{{course.studentName}}</text></view><text class="status">{{course.statusLabel}}</text></view><view class="time">{{course.time}}</view><view class="name">{{course.className}}</view><view class="meta">{{course.primaryCoach.name || '教练待定'}} · {{course.venue}}</view><view class="theme">{{course.sourceType === 'MATCH' ? course.trainingTheme : '训练主题：' + course.trainingTheme}}</view><view class="leave" wx:if="{{course.leaveLabel}}">{{course.leaveLabel}}</view><view class="match-note" wx:if="{{course.sourceType === 'MATCH'}}">{{course.trainingFocus}}</view></view></view></view><view class="empty card timetable-empty" wx:if="{{!groups.length}}"><view wx:if="{{joinedClassNames}}">已加入 {{joinedClassNames}}</view><view>{{joinedClassNames ? '当前暂无新的训练安排' : '暂未加入班级'}}</view><view class="muted small" wx:if="{{joinedClassNames}}">新的课程安排发布后，会自动显示在“我的课表”中。</view></view></block></view>
