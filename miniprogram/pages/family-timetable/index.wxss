.child-picker{background:#fff;border:1rpx solid #edf1f6;border-radius:18rpx;padding:21rpx;margin-top:16rpx;color:#173b77;font-weight:700}.week-nav{display:flex;justify-content:space-between;background:#fff;border:1rpx solid #edf1f6;border-radius:18rpx;padding:20rpx;margin:14rpx 0;color:#173b77}.week-nav .current{background:#173b77;color:#fff;border-radius:999rpx;padding:9rpx 24rpx}.summary{display:flex;justify-content:space-between;color:#66727e;padding:6rpx 6rpx 16rpx}.day-title{font-size:30rpx;font-weight:800;margin:22rpx 0 12rpx}.timeline{border-left:4rpx solid #dbe3ee;padding-left:20rpx}.card{background:#fff;border:1rpx solid #edf1f6;border-radius:20rpx;padding:22rpx;margin-bottom:14rpx}.between{display:flex;justify-content:space-between}.tag,.child{display:inline-block;background:#eaf0f9;color:#173b77;padding:6rpx 14rpx;border-radius:999rpx;font-size:20rpx}.child{background:#edf1f8;color:#173b77;margin-left:8rpx}.status{font-size:22rpx;color:#7a817d}.time{font-size:29rpx;color:#173b77;font-weight:800;margin-top:12rpx}.name{font-size:30rpx;font-weight:800;margin-top:7rpx}.meta,.theme,.match-note{font-size:23rpx;color:#66727e;margin-top:8rpx}.leave{background:#eef6ff;color:#175b95;padding:10rpx 14rpx;border-radius:12rpx;margin-top:12rpx}.match-note{color:#a86100}
.timetable-empty{line-height:1.8}.timetable-empty .muted{margin-top:8rpx}
