<view class="page page-enter">
  <view class="card" wx:if="{{role !== 'coach' && students.length && catalog.length}}">
    <view class="card-title">购买课时套餐</view>
    <view class="field"><text class="field-label">学员</text><picker range="{{students}}" range-key="name" value="{{studentIndex}}" bindchange="student"><view class="picker">{{students[studentIndex].name}}</view></picker></view>
    <view class="field"><text class="field-label">训练套餐</text><picker range="{{catalog}}" range-key="displayName" value="{{catalogIndex}}" bindchange="catalog"><view class="picker">{{catalog[catalogIndex].displayName}}</view></picker><view class="validity-tip">有效期从首次正式训练消课开始计算</view></view>
    <view class="field"><text class="field-label">优惠券编码</text><input class="input" value="{{couponCode}}" bindinput="coupon" placeholder="没有可不填"/></view>
    <button class="btn-primary" loading="{{creating}}" bindtap="create">确认购买</button>
  </view>
  <view class="notice" wx:if="{{role !== 'coach' && !loading && (!students.length || !catalog.length)}}">请先添加孩子，或联系管理员配置销售中的课时套餐。</view>
  <view class="section-title">{{role === 'admin' ? '全部订单' : '我的订单'}}</view>
  <view class="loading-state" wx:if="{{loading}}">加载中...</view>
  <view class="card order" wx:for="{{orders}}" wx:key="id">
    <view class="between"><view><view class="order-title">{{item.displayName}}</view><view class="muted small">{{item.studentName}} · {{item.orderNo}}</view><view class="muted small" wx:if="{{item.validityMonthsSnapshot}}">{{item.lessonCount}}节 · 有效期快照：激活后{{item.validityMonthsSnapshot}}个月</view></view><view class="amount">¥{{item.amountYuan}}</view></view>
    <view class="between footer"><text class="tag">{{item.status === 'PAID' ? '已支付' : (item.paymentStatus === 'PAYMENT_REVIEW_REQUIRED' ? '支付待人工复核' : '待支付')}}</text><text class="muted small">{{item.createdAt}}</text></view>
    <button wx:if="{{role === 'parent' && item.status === 'PENDING_PAYMENT'}}" class="btn-primary confirm" loading="{{paying === item.id}}" data-id="{{item.id}}" bindtap="pay">微信支付</button>
    <button wx:if="{{role === 'admin' && item.status === 'PENDING_PAYMENT' && item.paymentMethod !== 'WECHAT_PAY'}}" class="btn-secondary confirm" loading="{{confirming === item.id}}" data-id="{{item.id}}" bindtap="confirm">确认线下到账</button>
  </view>
  <view class="empty card" wx:if="{{!loading && orders.length === 0}}">暂无订单</view>
</view>
