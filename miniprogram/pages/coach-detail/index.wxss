.coach-page{padding-top:28rpx}.profile-head{padding:8rpx 0 26rpx}.hero-avatar{width:176rpx;height:176rpx;border-width:6rpx;box-shadow:0 8rpx 28rpx rgba(23,59,119,.12)}.hero-avatar.fallback{line-height:164rpx;font-size:56rpx}.key-grid{gap:14rpx;margin-bottom:18rpx}.key-item{min-height:126rpx;padding:20rpx 16rpx;border:1rpx solid #edf1f6;border-radius:18rpx}
