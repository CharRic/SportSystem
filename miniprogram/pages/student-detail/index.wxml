<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view>
<view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重新加载</view></view>
<view class="page page-enter" wx:elif="{{student}}">
  <view class="profile card">
    <image wx:if="{{student.avatarUrl}}" class="avatar photo-editable" src="{{student.avatarUrl}}" mode="aspectFill" bindtap="replacePhoto"/><view wx:else class="avatar photo-editable" bindtap="replacePhoto">{{uploadingPhoto ? '…' : student.initial}}</view>
    <view class="grow"><view class="name">{{student.name}}</view><view class="muted small">{{student.gender}} · 出生于 {{student.birthDate}}</view></view>
    <view class="lesson-box {{student.lowBalance ? 'low' : ''}}"><text class="count">{{student.remainingLessons}}</text><text class="small">{{student.lowBalance ? '建议续费' : '剩余课时'}}</text></view>
  </view>
  <view class="muted small photo-tip" wx:if="{{role === 'admin' || role === 'parent'}}">点击孩子照片可从相册选择或重新拍摄</view>
  <view class="card growth-entry pressable" bindtap="growth"><view><view class="card-title">球员成长档案</view><view class="muted small">阶段测评 · 训练评价 · 历史趋势</view></view><text class="link">查看 ›</text></view>
  <view class="card">
    <view class="between"><view class="card-title">基本信息</view><view><text class="invite" wx:if="{{role === 'admin' && mode === 'cloud' && !student.ownerParentUserId}}" bindtap="parentInvite">家长邀请码</text><text class="edit" wx:if="{{role === 'admin'}}" bindtap="edit">编辑</text></view></view>
    <view class="info"><text class="muted">家长姓名</text><text>{{student.guardianName}}</text></view>
    <view class="info"><text class="muted">联系电话</text><text>{{student.guardianPhone}}</text></view>
    <view class="info"><text class="muted">紧急联系人</text><text class="right">{{student.emergencyContact || '未登记'}}</text></view>
    <view class="info"><text class="muted">累计购课</text><text>{{student.totalLessons}} 节</text></view>
    <view class="info"><text class="muted">健康备注</text><text class="right">{{student.healthNotes || '无'}}</text></view>
    <view class="info pressable" wx:if="{{role === 'admin'}}" bindtap="privateProfile"><text class="muted">身份信息</text><text class="link">单独授权查看 ›</text></view>
    <view class="info pressable" wx:if="{{role === 'admin'}}" bindtap="transferParent"><text class="muted">家长账号归属</text><text class="link">查看或转移 ›</text></view>
  </view>

  <view wx:if="{{student.recruitment && role !== 'parent'}}">
    <view class="section-title">招生来源</view>
    <view class="card"><view class="info"><text class="muted">来源渠道</text><text>{{student.recruitment.source || '未登记'}}</text></view><view class="info"><text class="muted">招生负责人</text><text>{{student.recruitment.ownerCoachName || '未分配'}}</text></view><view class="info"><text class="muted">首次联系</text><text>{{student.recruitment.firstContactAt || '未登记'}}</text></view><view class="info"><text class="muted">最近体验课</text><text>{{student.recruitment.trialDate || '未参加'}}</text></view><view class="info" wx:if="{{student.recruitment.trialFeedback}}"><text class="muted">体验课反馈</text><text class="right">{{student.recruitment.trialFeedback}}</text></view></view>
  </view>

  <view class="section-title">{{role === 'parent' ? '我的班级' : '所在班级'}}</view>
  <view class="card {{role === 'parent' ? 'pressable' : ''}}" wx:for="{{student.classes}}" wx:key="id" data-id="{{item.id}}" bindtap="classDetail">
    <view class="between"><view><view class="card-title">{{item.name}}</view><view class="class-badges"><text class="tag">{{item.classTypeLabel || (item.classType === 'ELITE' ? '精英队' : '普通班')}}</text><text class="member-status">正式成员</text></view><view class="muted small mt">{{item.schedule}} · {{item.venue}}</view></view><view class="tag" wx:if="{{role !== 'parent'}}">{{item.coachName}}</view><text class="link" wx:else>班级详情 ›</text></view>
  </view>
  <view class="empty card" wx:if="{{student.classes.length === 0}}">暂未加入班级</view>
  <view class="section-title" wx:if="{{role !== 'coach'}}">课时权益</view>
  <view class="card entitlement" wx:if="{{role !== 'coach'}}" wx:for="{{student.lessonEntitlements}}" wx:key="id"><view class="between"><view><view class="card-title">{{item.packageName}}</view><view class="muted small">剩余 {{item.remainingLessons}} / {{item.purchasedLessons}} 节</view></view><view class="tag {{item.status === 'EXPIRED' ? 'danger' : ''}}">{{item.statusLabel}}</view></view><view class="validity-message">{{item.validityMessage}}</view><view class="muted small" wx:if="{{item.activatedAt}}">激活日期：{{item.activatedAt}}</view><view class="muted small" wx:if="{{item.extensionDays}}">累计延期：{{item.extensionDays}}天</view><button class="btn-secondary entitlement-extend" wx:if="{{role === 'admin' && item.status !== 'EXHAUSTED'}}" data-id="{{item.id}}" bindtap="extendEntitlement">延长有效期</button></view>
  <view class="empty card" wx:if="{{role !== 'coach' && (!student.lessonEntitlements || student.lessonEntitlements.length === 0)}}">暂无套餐课时权益，历史期初课时继续按原账本管理。</view>
  <view class="section-title" wx:if="{{role !== 'coach'}}">课时流水</view>
  <view class="card" wx:if="{{role !== 'coach'}}"><view class="ledger" wx:for="{{student.lessonLedger}}" wx:key="id"><view><view>{{item.note}}</view><view class="muted small">{{item.createdAt}} · 余额 {{item.balanceAfter}}</view></view><text class="delta {{item.delta > 0 ? 'plus' : 'minus'}}">{{item.delta > 0 ? '+' : ''}}{{item.delta}}</text></view><view class="empty" wx:if="{{!student.lessonLedger || student.lessonLedger.length === 0}}">暂无课时流水</view></view>

  <view class="section-title">最近出勤</view>
  <view class="card">
    <view class="record" wx:for="{{student.attendance}}" wx:key="id">
      <view><view>{{item.date}}</view><view class="muted small">扣除 {{item.deductedLessons}} 节课</view></view>
      <view class="tag {{item.status === 'absent' ? 'danger' : (item.status === 'leave' || item.status === 'sick' ? 'warning' : '')}}">{{item.statusLabel}}</view>
    </view>
    <view class="empty" wx:if="{{student.attendance.length === 0}}">暂无点名记录</view>
  </view>
  <view class="sticky-action" wx:if="{{role !== 'coach'}}"><button class="btn-primary" bindtap="renew">续费 / 购买课时</button></view>
</view>
