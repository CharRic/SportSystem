.timetable-page{padding-bottom:80rpx}.week-nav{display:flex;justify-content:space-between;align-items:center;background:#fff;padding:24rpx;border-radius:20rpx;margin-top:20rpx;color:#173b77}.week-nav .current{background:#173b77;color:#fff;border-radius:999rpx;padding:12rpx 30rpx}.date-picker{padding:18rpx;text-align:center;color:#66716b}.summary{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin:12rpx 0 20rpx}.summary view{background:#fff;border-radius:18rpx;padding:18rpx 4rpx;text-align:center}.summary view.active{outline:3rpx solid #d49312}.summary text{display:block}.summary text:first-child{font-size:34rpx;font-weight:800;color:#173b77}.summary text:last-child{font-size:19rpx;color:#7a817d}.mode-tabs{white-space:nowrap;margin-bottom:16rpx}.mode{display:inline-block;padding:16rpx 30rpx;background:#e9edeb;margin-right:12rpx;border-radius:999rpx}.mode.active{background:#08783f;color:#fff}.filters{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-bottom:24rpx}.filters view{background:#fff;padding:18rpx;border-radius:14rpx;font-size:22rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.group-title{font-size:30rpx;font-weight:800;margin:30rpx 4rpx 16rpx}.group-title text{font-size:22rpx;color:#7a817d;margin-left:12rpx}.card{background:#fff;border-radius:22rpx;padding:24rpx;margin-bottom:16rpx}.between{display:flex;justify-content:space-between}.tag{display:inline-block;background:#e5f4ea;color:#08783f;padding:6rpx 14rpx;border-radius:999rpx;font-size:20rpx;margin-right:8rpx}.tag.type{background:#edf1f8;color:#173b77}.status{font-size:22rpx;color:#7a817d}.course-name{font-size:31rpx;font-weight:800;margin:16rpx 0 8rpx}.time{color:#173b77;font-weight:700}.meta,.coach,.theme{font-size:23rpx;color:#657069;margin-top:9rpx}.warnings{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:16rpx}.warnings text{background:#fff0e8;color:#bf521f;padding:8rpx 12rpx;border-radius:10rpx;font-size:20rpx}
.mode{padding:14rpx 26rpx;background:#edf1f6}.mode.active{background:#173b77}.card{border:1rpx solid #edf1f6;border-radius:20rpx;padding:22rpx;margin-bottom:14rpx}.tag{background:#eaf0f9;color:#173b77}
