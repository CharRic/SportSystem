.hero{border-radius:22rpx;padding:28rpx}.title{font-size:40rpx;font-weight:800;margin:14rpx 0 8rpx}.sub{color:#dce6f6}.edit{color:#e4c55d}.metrics{display:grid;grid-template-columns:repeat(3,1fr);text-align:center;margin-top:18rpx}.metrics text{display:block}.metrics text:first-child{font-size:36rpx;font-weight:800;color:#173b77}.metrics text:last-child{font-size:21rpx;color:#8a94a5;margin-top:6rpx}.info{display:flex;justify-content:space-between;padding:13rpx 0}.warning{color:#b35a00;background:#fff3e6;padding:14rpx;border-radius:14rpx;margin-top:10rpx}.actions{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.student-picker{color:#173b77;display:flex;align-items:center;gap:16rpx}.member-head{display:flex;align-items:center;gap:18rpx}.member-avatar{width:82rpx;height:82rpx;border-radius:50%;flex:none}.member-avatar.fallback{background:#eaf0f9;color:#173b77;text-align:center;line-height:82rpx;font-weight:800}.member-name{font-size:30rpx;font-weight:750}.status{font-size:20rpx;color:#17804a}.member-meta{margin-top:10rpx}.feedback{margin:16rpx 0}.member-actions{display:flex;gap:26rpx;flex-wrap:wrap;color:#2d5ea8;font-size:24rpx;border-top:1rpx solid #edf0f5;padding-top:16rpx}.danger-text{color:#bd3c3c}
.coach-line{display:flex;align-items:center;gap:10rpx}.coach-line image,.coach-avatar-fallback{width:42rpx;height:42rpx;border-radius:50%}.coach-avatar-fallback{display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.18);font-size:20rpx;font-weight:700}
.coach-card,.assistant-row{display:flex;align-items:center;gap:18rpx}.coach-card image,.assistant-row image,.coach-card .coach-avatar-fallback,.assistant-row .coach-avatar-fallback{width:76rpx;height:76rpx;border-radius:50%;background:#eaf0f9;color:#173b77}.coach-name{font-size:30rpx;font-weight:750;margin-top:6rpx}.right{text-align:right;max-width:62%}.parent-session{border-left:7rpx solid #173b77}.session-date{font-size:28rpx;font-weight:750}.session-time{color:#173b77;font-weight:800;margin-top:8rpx}.session-meta,.session-theme{margin-top:10rpx}.classmate-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14rpx}.classmate{background:#fff;border:1rpx solid #edf1f6;border-radius:18rpx;padding:18rpx;display:flex;align-items:center;gap:14rpx;min-width:0}.classmate.mine{box-shadow:0 0 0 2rpx #6d8abd inset;background:#f5f8fd}.classmate image,.classmate-fallback{width:68rpx;height:68rpx;border-radius:50%;flex:none}.classmate-fallback{background:#eaf0f9;color:#173b77;display:flex;align-items:center;justify-content:center;font-weight:800}.classmate-name{font-size:24rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.classmate.mine .classmate-name{color:#173b77;font-weight:750}
.development{border-left:7rpx solid #c89d2a}.stage-name{color:#173b77;font-size:28rpx;font-weight:800}.development-summary{line-height:1.7;margin:14rpx 0}.goal{color:#53616e;font-size:24rpx;line-height:1.65}.training-tags{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:18rpx}.training-tags text{background:#eaf0f9;color:#173b77;border-radius:999rpx;padding:10rpx 18rpx;font-size:23rpx}.weekly-plan{border-left:7rpx solid #173b77}.weekly-theme{font-size:31rpx;font-weight:800;color:#173b77;margin-top:8rpx}.weekly-label{margin-top:18rpx}.weekly-focus{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:8rpx}.weekly-focus text{background:#f1f5fb;color:#2d5ea8;border-radius:12rpx;padding:9rpx 15rpx;font-size:22rpx}
