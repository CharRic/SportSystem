.hero{border-radius:28rpx;padding:32rpx}.title{font-size:43rpx;font-weight:800;margin:18rpx 0 10rpx}.sub{color:#dce6f6}.edit{color:#e4c55d}.metrics{display:grid;grid-template-columns:repeat(3,1fr);text-align:center;margin-top:20rpx}.metrics text{display:block}.metrics text:first-child{font-size:38rpx;font-weight:800;color:#173b77}.metrics text:last-child{font-size:21rpx;color:#8a94a5;margin-top:8rpx}.info{display:flex;justify-content:space-between;padding:15rpx 0}.warning{color:#b35a00;background:#fff3e6;padding:16rpx;border-radius:14rpx;margin-top:12rpx}.actions{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.student-picker{color:#173b77;display:flex;align-items:center;gap:16rpx}.member-head{display:flex;align-items:center;gap:18rpx}.member-avatar{width:82rpx;height:82rpx;border-radius:50%;flex:none}.member-avatar.fallback{background:#e9f5ee;color:#12643b;text-align:center;line-height:82rpx;font-weight:800}.member-name{font-size:30rpx;font-weight:750}.status{font-size:20rpx;color:#17804a}.member-meta{margin-top:12rpx}.feedback{margin:18rpx 0}.member-actions{display:flex;gap:28rpx;flex-wrap:wrap;color:#2d5ea8;font-size:24rpx;border-top:1rpx solid #edf0f5;padding-top:18rpx}.danger-text{color:#bd3c3c}
