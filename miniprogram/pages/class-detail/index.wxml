<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view>
<view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重新加载</view></view>
<view class="page page-enter" wx:elif="{{clubClass}}">
  <view class="hero brand-hero"><view class="between"><view class="tag gold">班级号 {{clubClass.classCode}}</view><view class="edit" wx:if="{{role === 'admin' || role === 'coach'}}" bindtap="edit">编辑班级</view></view><view class="title">{{clubClass.name}}</view><view class="sub">{{clubClass.ageGroup}} · {{clubClass.headCoachName}}</view></view>
  <view class="card metrics"><view><text>{{clubClass.studentCount}}</text><text>当前正式成员</text></view><view><text>{{clubClass.standardCapacity}}</text><text>标准人数</text></view><view><text>{{clubClass.overCapacity}}</text><text>超出标准人数</text></view></view>
  <view class="card"><view class="info"><text class="muted">训练时间</text><text>{{clubClass.schedule}}</text></view><view class="info"><text class="muted">训练场地</text><text>{{clubClass.venue}}</text></view><view class="info"><text class="muted">助理教练</text><text>{{clubClass.assistantCoachName || '未安排'}}</text></view><view class="warning" wx:if="{{clubClass.overCapacity}}">当前已超过标准容量 {{clubClass.overCapacity}} 人</view></view>
  <view class="actions" wx:if="{{role === 'admin'}}"><button class="btn-primary" bindtap="add">+ 添加学员</button></view>
  <picker wx:if="{{role === 'parent' && students.length > 1}}" range="{{students}}" range-key="name" value="{{studentIndex}}" bindchange="studentChange"><view class="card student-picker"><image wx:if="{{students[studentIndex].avatarUrl}}" src="{{students[studentIndex].avatarUrl}}" mode="aspectFill"/><view wx:else class="member-avatar fallback">{{students[studentIndex].initial}}</view><view class="grow">报名学员：{{students[studentIndex].name}}</view><text>切换 ›</text></view></picker>
  <button wx:if="{{role === 'parent'}}" class="{{clubClass.classType === 'REGULAR' && !clubClass.isFull ? 'btn-primary' : 'btn-secondary'}}" disabled="{{clubClass.classType === 'ELITE' || clubClass.isFull || students.length === 0}}" bindtap="join">{{clubClass.classType === 'ELITE' ? '俱乐部选拔制' : clubClass.isFull ? '本班已满' : '报名普通班'}}</button>
  <view class="between section-title" wx:if="{{role !== 'parent'}}"><text>正式成员名单</text><switch wx:if="{{role === 'admin'}}" checked="{{includeInactive}}" bindchange="toggleHistory" color="#173B77"/><text class="muted small" wx:if="{{role === 'admin'}}">含退出历史</text></view>
  <view class="card member" wx:if="{{role !== 'parent'}}" wx:for="{{clubClass.members}}" wx:key="id"><view class="member-head"><image wx:if="{{item.student.avatarUrl}}" class="member-avatar" src="{{item.student.avatarUrl}}" mode="aspectFill"/><view wx:else class="member-avatar fallback">{{item.student.initial}}</view><view class="grow"><view class="between"><view><view class="member-name">{{item.student.name}} <text class="status">{{item.statusLabel}}</text></view><view class="muted small">{{item.student.birthYear}} · {{item.student.classNames || '暂无其他班级'}}</view></view><view class="tag">{{item.student.remainingLessons}} 课时</view></view></view></view><view class="muted small member-meta">加入：{{item.joinedAt}} · 来源：{{item.source}}</view><view class="member-actions" wx:if="{{item.status === 'ACTIVE'}}"><text data-student="{{item.student.id}}" bindtap="student">学员详情</text><text wx:if="{{role === 'admin'}}" data-member="{{item.id}}" bindtap="transfer">转班</text><text wx:if="{{role === 'admin'}}" class="danger-text" data-member="{{item.id}}" bindtap="remove">移出</text></view></view>
  <view class="empty card" wx:if="{{role !== 'parent' && clubClass.members.length === 0}}">暂无队员</view>
</view>
