<view class="loading-state" wx:if="{{loading}}"><text class="loading-dot"></text><text class="loading-dot"></text><text class="loading-dot"></text></view>
<view class="error-state" wx:elif="{{error}}">{{error}}<view class="retry" bindtap="load">重新加载</view></view>
<view class="page page-enter" wx:elif="{{clubClass}}">
  <view class="hero brand-hero"><view class="between"><view class="tag gold">{{clubClass.classTypeLabel}} · 班级号 {{clubClass.classCode}}</view><view class="edit" wx:if="{{role === 'admin' || role === 'coach'}}" bindtap="edit">编辑班级</view></view><view class="title">{{clubClass.name}}</view><view class="sub">{{clubClass.ageGroup}}</view></view>
  <view class="card metrics" wx:if="{{role !== 'parent'}}"><view><text>{{clubClass.studentCount}}</text><text>当前正式成员</text></view><view><text>{{clubClass.standardCapacity}}</text><text>标准人数</text></view><view><text>{{clubClass.overCapacity}}</text><text>超出标准人数</text></view></view>
  <view class="section-title" wx:if="{{role === 'parent'}}">教练团队</view>
  <view class="card coach-card pressable" data-id="{{clubClass.headCoach.coachId}}" bindtap="coach"><image wx:if="{{clubClass.headCoach.avatarUrl}}" src="{{clubClass.headCoach.avatarUrl}}" mode="aspectFill"/><view wx:else class="coach-avatar-fallback">教</view><view class="grow"><view class="muted small">主教练</view><view class="coach-name">{{clubClass.headCoach.name || clubClass.headCoachName}}</view></view><text class="link" wx:if="{{clubClass.headCoach.coachId}}">查看介绍 ›</text></view>
  <view class="card assistant-row pressable" wx:for="{{clubClass.assistantCoaches}}" wx:key="coachId" data-id="{{item.coachId}}" bindtap="coach"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="coach-avatar-fallback">教</view><view class="grow"><view class="muted small">助理教练</view><view>{{item.name}}</view></view><text class="link" wx:if="{{item.coachId}}">查看介绍 ›</text></view>
  <view class="card"><view class="info"><text class="muted">常规训练时间</text><text class="right">{{clubClass.schedule || '待发布'}}</text></view><view class="info"><text class="muted">主要训练场地</text><text class="right">{{clubClass.venue || '待发布'}}</text></view><view class="info" wx:if="{{role !== 'parent'}}"><text class="muted">助理教练</text><text>{{clubClass.assistantCoachName || '未安排'}}</text></view><view class="warning" wx:if="{{role !== 'parent' && clubClass.overCapacity}}">当前已超过标准容量 {{clubClass.overCapacity}} 人</view></view>
  <view class="actions" wx:if="{{role === 'admin'}}"><button class="btn-primary" bindtap="add">+ 添加学员</button><button class="btn-secondary" wx:if="{{clubClass.classType === 'ELITE'}}" bindtap="selections">推荐审核（{{clubClass.pendingSelectionCount}}）</button></view>
  <picker wx:if="{{role === 'parent' && students.length > 1}}" range="{{students}}" range-key="name" value="{{studentIndex}}" bindchange="studentChange"><view class="card student-picker"><image wx:if="{{students[studentIndex].avatarUrl}}" src="{{students[studentIndex].avatarUrl}}" mode="aspectFill"/><view wx:else class="member-avatar fallback">{{students[studentIndex].initial}}</view><view class="grow">报名学员：{{students[studentIndex].name}}</view><text>切换 ›</text></view></picker>
  <button wx:if="{{role === 'parent' && !joined}}" class="{{clubClass.classType === 'REGULAR' && !clubClass.isFull ? 'btn-primary' : 'btn-secondary'}}" disabled="{{clubClass.classType === 'ELITE' || clubClass.isFull || students.length === 0}}" bindtap="join">{{clubClass.classType === 'ELITE' ? '俱乐部选拔制' : clubClass.isFull ? '本班已满' : '报名普通班'}}</button>
  <block wx:if="{{role === 'parent' && joined}}"><view class="section-title">阶段培养目标</view><view class="card development" wx:if="{{trainingOverview.curriculum}}"><view class="stage-name">{{trainingOverview.ageStage}}阶段</view><view class="development-summary">{{trainingOverview.curriculum.parentSummary}}</view><view class="goal" wx:for="{{trainingOverview.curriculum.parentGoals}}" wx:key="*this">· {{item}}</view></view><view class="empty card" wx:else>该年龄段培养内容正在完善中。</view><view class="section-title" wx:if="{{trainingOverview.curriculum}}">本阶段主要训练内容</view><view class="training-tags" wx:if="{{trainingOverview.curriculum}}"><text wx:for="{{trainingOverview.curriculum.parentTrainingAreas}}" wx:key="*this">{{item}}</text></view><view class="section-title">本周训练</view><view class="card weekly-plan" wx:if="{{trainingOverview.weeklyPlan}}"><view class="muted small">本周主题</view><view class="weekly-theme">{{trainingOverview.weeklyPlan.mainTheme}}</view><view class="muted small weekly-label">本周重点</view><view class="weekly-focus"><text wx:for="{{trainingOverview.weeklyPlan.trainingFocus}}" wx:key="*this">{{item}}</text></view></view><view class="empty card" wx:else>本周训练计划尚未发布。</view><view class="section-title">近期课程</view><view class="card parent-session" wx:for="{{clubClass.upcomingSessions}}" wx:key="sessionId"><view class="between"><view><view class="session-date">{{item.date}} {{item.weekday}}</view><view class="session-time">{{item.time}}</view></view><view class="tag">已发布</view></view><view class="muted small session-meta">{{item.venue}} · {{item.coach.name || '教练待定'}}</view><view class="session-theme">训练主题：{{item.trainingTheme || '待发布'}}</view></view><view class="empty card" wx:if="{{!clubClass.upcomingSessions.length}}">暂未发布新的训练安排。</view><view class="between section-title"><text>同班同学</text><text class="muted small">{{clubClass.studentCount}}人</text></view><view class="classmate-grid"><view class="classmate {{item.isMine ? 'mine' : ''}}" wx:for="{{clubClass.classmates}}" wx:key="studentId" data-id="{{item.studentId}}" data-mine="{{item.isMine}}" bindtap="classmate"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"/><view wx:else class="classmate-fallback">{{item.initial}}</view><view class="classmate-name">{{item.displayName}} <text wx:if="{{item.isMine}}">（我）</text></view></view></view></block>
  <view class="between section-title" wx:if="{{role !== 'parent'}}"><text>正式成员名单</text><switch wx:if="{{role === 'admin'}}" checked="{{includeInactive}}" bindchange="toggleHistory" color="#173B77"/><text class="muted small" wx:if="{{role === 'admin'}}">含退出历史</text></view>
  <view class="card member" wx:if="{{role !== 'parent'}}" wx:for="{{clubClass.members}}" wx:key="id"><view class="member-head"><image wx:if="{{item.student.avatarUrl}}" class="member-avatar" src="{{item.student.avatarUrl}}" mode="aspectFill"/><view wx:else class="member-avatar fallback">{{item.student.initial}}</view><view class="grow"><view class="between"><view><view class="member-name">{{item.student.name}} <text class="status">{{item.statusLabel}}</text></view><view class="muted small">{{item.student.birthYear}} · {{item.student.regularClassNames || item.student.classNames || '暂无其他班级'}}</view></view><view class="tag {{item.student.trainingLevel === '精英队' ? 'gold' : ''}}">{{item.student.trainingLevel}}</view></view></view></view><view class="muted small member-meta">加入：{{item.joinedAt}} · 来源：{{item.source}}</view><view class="member-actions" wx:if="{{role === 'admin' && item.status === 'ACTIVE'}}"><text data-student="{{item.student.id}}" bindtap="student">成长档案</text><text data-member="{{item.id}}" bindtap="transfer">转班/调队</text><text wx:if="{{clubClass.classType === 'REGULAR'}}" data-student="{{item.student.id}}" bindtap="elite">晋升精英队</text><text class="danger-text" data-member="{{item.id}}" bindtap="remove">移出</text></view><view class="member-actions" wx:elif="{{role === 'coach' && item.status === 'ACTIVE'}}"><text data-student="{{item.student.id}}" bindtap="student">成长档案</text><text wx:if="{{clubClass.classType === 'REGULAR'}}" data-student="{{item.student.id}}" bindtap="elite">推荐进入精英队</text></view></view>
  <view class="empty card" wx:if="{{role !== 'parent' && clubClass.members.length === 0}}">暂无队员</view>
</view>
