<view class="page page-enter"><view class="card"><view class="card-title">添加管理员</view><view class="muted small desc">生成一次性邀请码，对方在“我的”页面输入后成为管理员。</view><input class="input" placeholder="管理员姓名（可选）" value="{{name}}" bindinput="name"/><button class="btn-primary action" loading="{{creating}}" bindtap="inviteAdmin">生成管理员邀请码</button></view><view class="section-title">账号列表</view><view class="loading-state" wx:if="{{loading}}">加载中...</view><view class="card user" wx:for="{{users}}" wx:key="id"><view><view class="user-name">{{item.name}}</view><view class="muted small">{{item.mobile || '未登记手机号'}} · {{item.createdAt}}</view></view><view class="tag">{{item.roleLabel}}</view></view><view class="empty card" wx:if="{{!loading && users.length === 0}}">暂无账号</view></view>
