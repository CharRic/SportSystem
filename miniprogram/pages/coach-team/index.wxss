.team-hero{padding:42rpx 32rpx 58rpx;background:linear-gradient(145deg,#102f63,#28569a);color:#fff;border-radius:0 0 38rpx 38rpx}.team-eyebrow{font-size:21rpx;letter-spacing:3rpx;opacity:.68}.team-title{font-size:44rpx;font-weight:800;margin-top:12rpx}.team-sub{font-size:24rpx;opacity:.78;margin-top:10rpx}.list-head{margin-bottom:20rpx}.add-btn{margin:0;padding:0 24rpx;line-height:64rpx;border-radius:32rpx;background:#173b77;color:#fff;font-size:24rpx}.add-btn::after{border:0}.coach-card{display:flex;gap:24rpx;padding:26rpx}.coach-avatar{width:152rpx;height:184rpx;border-radius:22rpx;background:#eaf0f9;flex:none}.coach-avatar.fallback{text-align:center;line-height:184rpx;color:#173b77;font-size:52rpx;font-weight:800}.coach-info{flex:1;min-width:0}.coach-name{font-size:34rpx;font-weight:800;color:#17211b}.private-badge{padding:5rpx 12rpx;border-radius:12rpx;background:#eef1ef;color:#68706b;font-size:20rpx}.coach-title{font-size:26rpx;color:#173b77;font-weight:700;margin-top:8rpx}.credential{font-size:25rpx;margin-top:20rpx;line-height:1.45}.specialty-line{margin-top:14rpx;color:#8c6700;font-size:24rpx;line-height:1.45}.card-footer{margin-top:22rpx}.view-link{color:#173b77;font-size:24rpx;font-weight:700}.edit-link{padding:8rpx 14rpx;border-radius:14rpx;background:#fff6da;color:#8c6700;font-size:22rpx}
.filters{white-space:nowrap;margin:0 0 22rpx}.filter{display:inline-block;margin-right:12rpx;padding:12rpx 24rpx;border-radius:28rpx;background:#fff;color:#68706b;font-size:23rpx}.filter.on{background:#173b77;color:#fff}.account{display:inline-block;margin-left:8rpx;padding:5rpx 10rpx;border-radius:12rpx;font-size:19rpx}.account.BOUND{background:#e4f4eb;color:#176b42}.account.UNBOUND{background:#fff2cf;color:#8b6500}.account.INACTIVE{background:#ecefee;color:#6f7772}.invite-link{padding:8rpx 14rpx;margin-right:8rpx;border-radius:14rpx;background:#e4f4eb;color:#176b42;font-size:22rpx}
