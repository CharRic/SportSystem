<view class="page"><view class="notice">普通学员可直接注册。未成年人请由监护人填写，照片仅用于班级名单和点名。</view><view class="card"><view class="field-label photo-label">学员照片（可选）</view><view class="avatar-upload" bindtap="avatar"><image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill"/><view wx:else>{{uploading ? '正在上传...' : '＋ 上传照片'}}</view></view><view class="field"><text class="field-label">学员姓名 *</text><input class="input" value="{{profile.name}}" data-key="name" bindinput="field"/></view><view class="field"><text class="field-label">联系电话 *</text><input class="input" type="number" maxlength="11" value="{{profile.mobile}}" data-key="mobile" bindinput="field"/></view><view class="field"><text class="field-label">监护人姓名</text><input class="input" value="{{profile.guardianName}}" data-key="guardianName" bindinput="field" placeholder="成年学员可不填"/></view><view class="field"><text class="field-label">性别 *</text><radio-group bindchange="gender"><label><radio value="男" checked="{{profile.gender === '男'}}" color="#173b77"/>男</label><label><radio value="女" checked="{{profile.gender === '女'}}" color="#173b77"/>女</label></radio-group></view><view class="field"><text class="field-label">出生日期 *</text><picker mode="date" value="{{profile.birthDate}}" bindchange="date"><view class="picker">{{profile.birthDate}}</view></picker></view><view class="field"><text class="field-label">学校</text><input class="input" value="{{profile.school}}" data-key="school" bindinput="field"/></view><view class="field"><text class="field-label">年级</text><input class="input" value="{{profile.grade}}" data-key="grade" bindinput="field"/></view><view class="field"><text class="field-label">健康或训练备注</text><textarea class="textarea" value="{{profile.remark}}" data-key="remark" bindinput="field"/></view></view><button class="btn-primary" disabled="{{saving || uploading}}" loading="{{saving}}" bindtap="save">完成注册</button></view>
